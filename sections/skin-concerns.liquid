{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
{% liquid
  assign concern_count = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign concern_count = concern_count | plus: 1
    endif
  endfor
  assign concern_heading = section.settings.heading
  if concern_heading == blank
    assign concern_heading = 'skin_concerns.title' | t
  endif
%}
{% if concern_count > 0 or request.design_mode %}
  {{ 'skin-concerns.css' | asset_url | stylesheet_tag }}
  <section class="skin-concerns page-width section-space" aria-labelledby="ConcernsHeading-{{ section.id }}">
    <div class="skin-concerns__intro">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="ConcernsHeading-{{ section.id }}">{{ concern_heading | escape }}</h2>
      {% if section.settings.introduction != blank %}<p class="muted">{{ section.settings.introduction | escape }}</p>{% endif %}
    </div>
    {% if section.blocks.size > 0 %}
      <ul class="skin-concerns__list" role="list">
        {% for block in section.blocks %}
          {% assign concern_collection = block.settings.collection %}
          {% if concern_collection != blank %}
            {% assign concern_title = block.settings.title | default: concern_collection.title %}
            <li {{ block.shopify_attributes }}>
              <a class="skin-concerns__card" href="{{ concern_collection.url | escape }}" aria-labelledby="ConcernLabel-{{ section.id }}-{{ block.id }}"{% if block.settings.description != blank %} aria-describedby="ConcernDescription-{{ section.id }}-{{ block.id }}"{% endif %}>
                <span class="skin-concerns__top"><span class="skin-concerns__badge" id="ConcernLabel-{{ section.id }}-{{ block.id }}">{{ concern_title | escape }}</span><span class="skin-concerns__arrow" aria-hidden="true">↗</span></span>
                {% if block.settings.description != blank %}<span class="skin-concerns__description" id="ConcernDescription-{{ section.id }}-{{ block.id }}">{{ block.settings.description | escape }}</span>{% endif %}
              </a>
            </li>
          {% elsif request.design_mode %}
            <li class="editor-note" {{ block.shopify_attributes }}>{{ 'skin_concerns.empty' | t }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% elsif request.design_mode %}
      <p class="editor-note">{{ 'skin_concerns.empty' | t }}</p>
    {% endif %}
  </section>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
