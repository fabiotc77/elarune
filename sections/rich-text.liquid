{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
{%- liquid
  assign rich_text_heading_id = ''
  for block in section.blocks
    if block.type == 'heading' and block.settings.heading != blank
      assign rich_text_heading_id = 'RichTextHeading-' | append: block.id
      break
    endif
  endfor
  assign rich_text_has_content = false
  for block in section.blocks
    case block.type
      when 'divider'
        assign rich_text_has_content = true
      when 'heading'
        if block.settings.heading != blank
          assign rich_text_has_content = true
        endif
      when 'buttons'
        if block.settings.primary_label != blank or block.settings.secondary_label != blank
          assign rich_text_has_content = true
        endif
      else
        if block.settings.text != blank
          assign rich_text_has_content = true
        endif
    endcase
  endfor
-%}
{%- if rich_text_has_content -%}
  {{ 'section-rich-text.css' | asset_url | stylesheet_tag }}
  <section class="page-width section-space rich-text" data-align="{{ section.settings.content_alignment }}" data-align-mobile="{{ section.settings.mobile_alignment }}" data-width="{{ section.settings.content_width }}"{% if rich_text_heading_id != blank %} aria-labelledby="{{ rich_text_heading_id }}"{% endif %}>
    <div class="rich-text-inner premium-reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="eyebrow rich-text-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 id="RichTextHeading-{{ block.id }}" class="rich-text-heading" data-size="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rte rich-text-text" data-size="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}
          {%- when 'buttons' -%}
            {%- if block.settings.primary_label != blank or block.settings.secondary_label != blank -%}
              <div class="rich-text-actions" {{ block.shopify_attributes }}>
                {%- if block.settings.primary_label != blank -%}
                  <a data-control="primary" {% if block.settings.primary_link != blank %}href="{{ block.settings.primary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ block.settings.primary_label | escape }}</a>
                {%- endif -%}
                {%- if block.settings.secondary_label != blank -%}
                  <a data-control="{% if block.settings.secondary_style == 'text' %}text{% else %}secondary{% endif %}" {% if block.settings.secondary_link != blank %}href="{{ block.settings.secondary_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ block.settings.secondary_label | escape }}{% if block.settings.secondary_style == 'text' %}<span class="rich-text-arrow" aria-hidden="true">&rarr;</span>{% endif %}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- when 'divider' -%}
            <hr class="rich-text-divider" data-length="{{ block.settings.length }}" {{ block.shopify_attributes }}>
          {%- when 'caption' -%}
            {%- if block.settings.text != blank -%}
              <p class="rich-text-caption" data-style="{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}
{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
