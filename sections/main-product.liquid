{%- capture premium_section_body -%}
{% assign selected_variant = product.selected_or_first_available_variant %}
<script src="{{ 'product-submit.js' | asset_url }}" type="module"></script>
{% assign product_form_id = 'ProductForm-' | append: section.id %}
{% assign selected_allocation = nil %}
{% for allocation in selected_variant.selling_plan_allocations %}
  {% if allocation.selling_plan.id == selected_variant.selected_selling_plan_allocation.selling_plan.id %}{% assign selected_allocation = allocation %}{% break %}{% endif %}
{% endfor %}
{% assign purchase_ready = selected_variant.available %}
{% if selected_variant.requires_selling_plan and selected_allocation == nil %}{% assign purchase_ready = false %}{% endif %}
{% assign purchase_price = selected_allocation | default: selected_variant %}
<section class="page-width section-space product-layout" data-sticky-info="{{ section.settings.experience_sticky_info }}">
  {% render 'product-gallery', product: product, variant: selected_variant, section_id: section.id, gallery_layout: section.settings.experience_gallery, show_thumbnails: section.settings.experience_thumbnails %}
  <div class="product-info">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        {% case block.type %}
          {% when '@app' %}{% render block %}
          {% when 'vendor' %}<p class="eyebrow">{{ product.vendor | escape }}</p>
          {% when 'title' %}<h1>{{ product.title | escape }}</h1>
          {% when 'price' %}{% if selected_variant %}{% render 'price', target: purchase_price, unit_measurement: selected_variant.unit_price_measurement %}{% else %}<p>{{ 'product_options.unavailable_combination' | t }}</p>{% endif %}
            {% render 'product-purchase-notices', cart: cart, shop: shop, product: product %}
            {% if selected_allocation %}<p class="muted">{{ selected_allocation.selling_plan.name | escape }}</p>{% endif %}
          {% when 'inventory' %}
            {%- comment -%}Gift cards are issued, not stocked: batch and inventory language does not apply.{%- endcomment -%}
            {% unless product.gift_card? %}{% render 'product-inventory', product: product, variant: selected_variant, block: block %}{% endunless %}
          {% when 'volume_pricing' %}
            {% unless product.gift_card? %}{% render 'volume-pricing', product: product, variant: selected_variant, block: block, section_id: section.id %}{% endunless %}
          {% when 'description' %}<div class="rte">{{ product.description }}</div>
          {% when 'pickup_availability' %}{% render 'pickup-availability', product: product, variant: selected_variant %}
          {% when 'buy_buttons' %}
            {% render 'product-options', product: product, variant: selected_variant, allocation: selected_allocation, section_id: section.id %}
            {% render 'purchase-options', product: product, variant: selected_variant, allocation: selected_allocation, section_id: section.id %}
            {% if selected_variant %}
            {% form 'product', product, id: product_form_id, class: 'product-form' %}
              {{ form.errors | default_errors }}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
              {% if selected_allocation %}<input type="hidden" name="selling_plan" value="{{ selected_allocation.selling_plan.id }}">{% endif %}
              {% render 'gift-card-recipient', product: product, form: form, section_id: section.id %}
              <label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label><quantity-stepper data-increase="{{ 'premium.increase' | t | escape }}" data-decrease="{{ 'premium.decrease' | t | escape }}"><input data-control="quantity" id="Quantity-{{ section.id }}" type="number" name="quantity" required min="{{ selected_variant.quantity_rule.min | default: 1 }}" step="{{ selected_variant.quantity_rule.increment | default: 1 }}"{% if selected_variant.quantity_rule.max != blank %} max="{{ selected_variant.quantity_rule.max }}"{% endif %} value="{{ selected_variant.quantity_rule.min | default: 1 }}"></quantity-stepper>
              <button data-control="primary" id="ProductSubmit-{{ section.id }}" type="submit" class="button" name="add"{% unless purchase_ready %} disabled{% endunless %}>{% unless selected_variant.available %}{{ 'product.sold_out' | t }}{% elsif purchase_ready %}{{ 'product.add' | t }}{% else %}{{ 'purchase_options.choose' | t }}{% endunless %}</button>
              {% if purchase_ready %}{{ form | payment_terms }}{% endif %}
              {% if block.settings.dynamic_checkout and purchase_ready %}{% unless product.gift_card? %}{{ form | payment_button }}{% endunless %}{% endif %}
            {% endform %}
            {% render 'back-in-stock', product: product, variant: selected_variant, section_id: section.id %}
            {% else %}<button data-control="primary" class="button" type="button" disabled>{{ 'product_options.unavailable_combination' | t }}</button>{% endif %}
            {% if section.settings.sticky_add_to_cart %}
              {% render 'sticky-product', product: product, variant: selected_variant, section_id: section.id, product_form_id: product_form_id, allocation: selected_allocation, purchase_ready: purchase_ready %}
            {% endif %}
          {% when 'accordion' %}{% if block.settings.content != blank %}<details class="product-accordion"><summary data-control="disclosure">{{ block.settings.heading | escape }}</summary><div class="rte">{{ block.settings.content }}</div></details>{% endif %}
          {% when 'share' %}
            {% render 'product-share', product: product, block: block, section_id: section.id %}
          {% when 'custom_liquid' %}{{ block.settings.custom_liquid }}
        {% endcase %}
      </div>
    {% endfor %}
  </div>
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
