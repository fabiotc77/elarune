{%- capture premium_section_body -%}
{{ 'collection-list.css' | asset_url | stylesheet_tag }}
{%- assign collection_list_title = 'collection_list.title' | t -%}
<section class="collection-directory page-width section-space" aria-labelledby="CollectionDirectory-{{ section.id }}">
  <header class="collection-directory__header">
    <div class="collection-directory__intro">
    <h1 id="CollectionDirectory-{{ section.id }}">{{ section.settings.heading | default: collection_list_title | escape }}</h1>
    {%- if section.settings.introduction != blank -%}<div class="rte">{{ section.settings.introduction }}</div>{%- endif -%}
    </div>
    {%- if section.settings.show_shop_all -%}<a data-control="secondary" class="button button--secondary collection-directory__shop-all" href="{{ routes.all_products_collection_url }}">{{ 'collection_list.shop_all' | t }} <span aria-hidden="true">&rarr;</span></a>{%- endif -%}
  </header>
  {%- paginate collections by section.settings.collections_per_page -%}
    <div class="collection-directory__grid">
      {%- for entry in collections -%}
        <article class="collection-directory__card{% if entry.featured_image == blank %} collection-directory__card--text-only{% endif %}">
          <a href="{{ entry.url }}" aria-labelledby="CollectionTitle-{{ section.id }}-{{ entry.id }}">
            {%- if entry.featured_image != blank -%}
              <div class="collection-directory__image">{% assign image_loading = 'lazy' %}{% if forloop.first %}{% assign image_loading = 'eager' %}{% endif %}{{ entry.featured_image | image_url: width: 960 | image_tag: loading: image_loading, widths: '180, 240, 360, 540, 720, 960', sizes: '(min-width: 1440px) 310px, (min-width: 1200px) 22vw, (min-width: 750px) 45vw, 32vw', alt: '' }}</div>
            {%- endif -%}
            <div class="collection-directory__body">
            {%- if section.settings.show_product_count and entry.products_count != nil -%}
              <p class="collection-directory__count">{% if entry.products_count == 1 %}{{ 'collection_list.product_count_one' | t: count: entry.products_count }}{% else %}{{ 'collection_list.product_count_other' | t: count: entry.products_count }}{% endif %}</p>
            {%- endif -%}
            <h2 id="CollectionTitle-{{ section.id }}-{{ entry.id }}">{{ entry.title | escape }}</h2>
            {%- if section.settings.show_description and entry.description != blank -%}<p class="collection-directory__description">{{ entry.description | strip_html | truncatewords: 24 | escape_once }}</p>{%- endif -%}
            <span class="text-link">{{ 'general.view_all' | t }} <span class="collection-directory__arrow" aria-hidden="true">&rarr;</span></span>
            </div>
          </a>
        </article>
      {%- else -%}
        <p class="collection-directory__empty">{{ 'collection_list.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
