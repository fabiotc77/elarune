          "default": "Explore"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:editor.text.button_link_168eeb"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "t:slideshow.button_2_label"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "t:slideshow.button_2_link"
        },
        {
          "type": "header",
          "content": "t:editor.text.layout_a51190"
        },
        {
          "type": "select",
          "id": "text_horizontal",
          "label": "t:premium.x",
          "info": "t:slideshow.position_info",
          "options": [
            {
              "value": "start",
              "label": "t:slideshow.start"
            },
            {
              "value": "center",
              "label": "t:premium.center"
            },
            {
              "value": "end",
              "label": "t:slideshow.end"
            }
          ],
          "default": "start"
        },
        {
          "type": "select",
          "id": "text_vertical",
          "label": "t:premium.y",
          "options": [
            {
              "value": "top",
              "label": "t:slideshow.top"
            },
            {
              "value": "middle",
              "label": "t:slideshow.middle"
            },
            {
              "value": "bottom",
              "label": "t:slideshow.bottom"
            }
          ],
          "default": "bottom"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "t:slideshow.text_style",
          "options": [
            {
              "value": "none",
              "label": "t:premium.none"
            },
            {
              "value": "panel",
              "label": "t:slideshow.panel"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:slideshow.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "",
            "text_horizontal": "center",
            "text_vertical": "middle",
            "text_style": "panel"
          }
        }
      ]
    }
  ]
}
{% endschema %}
