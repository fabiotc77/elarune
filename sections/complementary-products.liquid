{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
{% liquid
  assign use_recommendations = false
  if section.settings.source == 'discovery' and product != blank
    assign use_recommendations = true
  endif
  assign suggested_products = section.settings.products
  assign resolved = false
  if use_recommendations and recommendations.performed? and recommendations.intent == 'complementary'
    assign resolved = true
    assign suggested_products = recommendations.products
  endif
  assign product_count = 0
  assign product_limit = section.settings.product_limit | default: 4
  assign complementary_title = section.settings.heading
  if complementary_title == blank
    assign complementary_title = 'complementary_products.title' | t
  endif
%}
{% capture product_cards %}
  {% for suggested_product in suggested_products %}
    {% if suggested_product == blank or suggested_product.id == product.id %}{% continue %}{% endif %}
    {% unless suggested_product.available %}{% continue %}{% endunless %}
    <li>{% render 'product-card', card_product: suggested_product %}</li>
    {% assign product_count = product_count | plus: 1 %}
    {% if product_count >= product_limit %}{% break %}{% endif %}
  {% endfor %}
{% endcapture %}
{% if product_count > 0 or use_recommendations or request.design_mode %}
  {{ 'complementary-products.css' | asset_url | stylesheet_tag }}
  {% if use_recommendations and resolved == false %}<script src="{{ 'complementary-products.js' | asset_url }}" type="module"></script>{% endif %}
  <complementary-products
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-resolved="{{ resolved }}"
    {% if use_recommendations and resolved == false %}data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id | url_encode }}&amp;product_id={{ product.id }}&amp;limit={{ product_limit }}&amp;intent=complementary"{% endif %}
  >
    <div data-complementary-content>
      {% if product_count > 0 %}
        <section class="complementary-products page-width section-space" aria-labelledby="ComplementaryTitle-{{ section.id }}">
          <div class="section-heading">
            <h2 id="ComplementaryTitle-{{ section.id }}">{{ complementary_title | escape }}</h2>
            {% if section.settings.introduction != blank %}<p class="muted">{{ section.settings.introduction | escape }}</p>{% endif %}
          </div>
          <ul class="complementary-products__grid" role="list">{{ product_cards }}</ul>
        </section>
      {% elsif request.design_mode %}
        <div class="page-width"><p class="editor-note">{{ 'complementary_products.empty' | t }}</p></div>
      {% endif %}
    </div>
  </complementary-products>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
