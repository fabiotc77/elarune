          "id": "mobile_y",
          "label": "t:premium.mobile_y",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50,
          "unit": "%"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "t:premium.map",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:premium.heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:premium.text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:premium.link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:premium.label"
        },
        {
          "type": "range",
          "id": "x",
          "label": "t:premium.x",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
