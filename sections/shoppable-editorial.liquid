    },
    {
      "type": "select",
      "id": "experience_motion",
      "label": "t:premium.motion",
      "options": [
        {
          "value": "inherit",
          "label": "t:premium.inherit"
        },
        {
          "value": "none",
          "label": "t:premium.none"
        },
        {
          "value": "fade",
          "label": "t:premium.fade"
        },
        {
          "value": "rise",
          "label": "t:premium.rise"
        },
        {
          "value": "scale",
          "label": "t:premium.scale"
        },
        {
          "value": "mask",
          "label": "t:premium.mask"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "experience_intensity",
      "label": "t:premium.intensity",
      "options": [
        {
          "value": "restrained",
          "label": "t:premium.restrained"
        },
        {
          "value": "editorial",
          "label": "t:premium.editorial"
        },
        {
          "value": "expressive",
          "label": "t:premium.expressive"
        }
      ],
      "default": "restrained"
    },
    {
      "type": "checkbox",
      "id": "experience_parallax",
      "label": "t:premium.parallax",
      "default": false
    },
    {
      "type": "select",
      "id": "experience_width",
      "label": "t:premium.width",
      "options": [
        {
          "value": "inherit",
          "label": "t:premium.inherit"
        },
        {
          "value": "contained",
          "label": "t:premium.contained"
        },
        {
          "value": "wide",
          "label": "t:premium.wide"
        },
        {
          "value": "full",
          "label": "t:premium.full"
        },
        {
          "value": "editorial",
          "label": "t:premium.editorial"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "experience_spacing",
      "label": "t:premium.spacing",
      "default": false
    },
    {
      "type": "range",
      "id": "experience_top",
      "label": "t:premium.top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "experience_bottom",
      "label": "t:premium.bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:premium.hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:premium.product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "t:premium.x",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 50,
          "unit": "%"
        },
        {
