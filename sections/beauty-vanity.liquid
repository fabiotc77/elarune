{% liquid
  assign product_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign product_count = product_count | plus: 1
    endif
  endfor
%}
{% if product_count > 0 %}
{{ 'beauty-vanity.css' | asset_url | stylesheet_tag }}
<script src="{{ 'beauty-vanity.js' | asset_url }}" type="module"></script>
<beauty-vanity class="vanity{% if section.settings.blend %} vanity--blend{% endif %}" data-routine-script="{{ 'routine-purchase.js' | asset_url }}" data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}" data-choose="{{ 'vanity.choose' | t | escape }}" data-change="{{ 'vanity.change' | t | escape }}" data-remove="{{ 'vanity.remove' | t | escape }}">
  <div data-vanity-purchase data-cart-url="{{ routes.cart_url }}" data-loading="{{ 'cart_upsell.adding' | t | escape }}" data-uncertain="{{ 'routine_purchase.uncertain' | t | escape }}" data-instruction="{{ 'routine_purchase.instruction' | t | escape }}">
    <div class="vanity__heading">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="VanityHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
    </div>
    <div class="vanity__workspace">
      <div class="vanity__scene" data-vanity-enhanced hidden>
        {% if section.settings.backdrop %}{{ section.settings.backdrop | image_url: width: 1600 | image_tag: class: 'vanity__backdrop', loading: 'lazy', widths: '600, 1000, 1600', sizes: '(min-width: 990px) 65vw, 100vw' }}{% endif %}
        <div class="vanity__objects">
          {% for step in (1..3) %}
            {% liquid
              assign step_value = step | append: ''
              assign step_key = 'step_' | append: step
              assign step_count = 0
              for block in section.blocks
                if block.settings.step == step_value and block.settings.product != blank
                  assign step_count = step_count | plus: 1
                endif
              endfor
            %}
            {% if step_count > 0 %}
              <button class="vanity__slot" type="button" data-vanity-slot="{{ step }}" data-label="{{ section.settings[step_key] | escape }}" aria-expanded="false" aria-controls="VanityPanel-{{ section.id }}">
                <span class="vanity__object" data-vanity-object></span>
                <span class="vanity__step"><i aria-hidden="true">0{{ step }}</i>{{ section.settings[step_key] | escape }}</span>
                <span class="vanity__slot-name" data-vanity-slot-name></span>
                <span class="vanity__slot-status" data-vanity-slot-status>{{ 'vanity.choose' | t }}</span>
              </button>
            {% endif %}
          {% endfor %}
        </div>
        <p class="vanity__hint">{{ 'vanity.hint' | t }}</p>
      </div>
    <div class="vanity__fallback" data-vanity-fallback><h3>{{ 'vanity.yours' | t }}</h3></div>
    <div class="vanity__panel" id="VanityPanel-{{ section.id }}" data-vanity-panel>
      <div class="vanity__panel-head" data-vanity-enhanced hidden>
        <h3 tabindex="-1" data-vanity-panel-title></h3>
        <button class="vanity__close" type="button" data-vanity-close>{{ 'vanity.close' | t }}</button>
      </div>
      <ul class="vanity__options" role="list">
        {% for block in section.blocks %}
          {% assign vanity_product = block.settings.product %}
          {% if vanity_product == blank %}{% continue %}{% endif %}
          {% render 'beauty-vanity-option', product: vanity_product, block: block, section_id: section.id %}
        {% endfor %}
      </ul>
    </div>
      <aside data-vanity-enhanced hidden class="vanity__receipt" aria-label="{{ 'vanity.yours' | t | escape }}">
        <div class="vanity__receipt-head"><h3>{{ 'vanity.yours' | t }}</h3><span class="vanity__count" data-vanity-count></span></div>
        <p class="vanity__empty" data-vanity-empty>{{ 'vanity.empty' | t }}</p>
        <ol class="vanity__summary" data-vanity-summary></ol>
        <div class="vanity__total" aria-live="polite" aria-atomic="true"><span>{{ 'vanity.total' | t }}</span><strong data-vanity-total></strong></div>
        <button class="vanity__add" type="button" data-routine-add disabled>{{ 'routine_purchase.add_selected' | t }}</button>
        <p data-routine-message role="status" aria-live="polite" aria-atomic="true"></p>
        <a data-routine-review href="{{ routes.cart_url }}" hidden>{{ 'cart_upsell.review' | t }}</a>
      </aside>
    </div>
  </div>
</beauty-vanity>
{% elsif request.design_mode %}<p class="page-width">{{ 'vanity.setup' | t }}</p>{% endif %}
{% schema %}
{
  "name": "t:vanity.name",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:editor.text.eyebrow_d821dd" },
    { "type": "text", "id": "heading", "label": "t:editor.text.heading_b34f17", "default": "Your ritual, your way" },
    { "type": "textarea", "id": "text", "label": "t:editor.text.introduction_b60535" },
    { "type": "text", "id": "step_1", "label": "t:vanity.step_one", "default": "Cleanse" },
    { "type": "text", "id": "step_2", "label": "t:vanity.step_two", "default": "Layer" },
    { "type": "text", "id": "step_3", "label": "t:vanity.step_three", "default": "Finish" },
    { "type": "image_picker", "id": "backdrop", "label": "t:vanity.backdrop" },
    { "type": "checkbox", "id": "blend", "label": "t:vanity.blend", "default": true },
    { "type": "paragraph", "content": "t:vanity.help" }
  ],
  "blocks": [{
    "type": "product", "name": "t:editor.text.product_fb9ef8", "settings": [
      { "type": "select", "id": "step", "label": "t:vanity.step", "options": [{ "value": "1", "label": "t:vanity.step_one" },{ "value": "2", "label": "t:vanity.step_two" },{ "value": "3", "label": "t:vanity.step_three" }], "default": "1" },
      { "type": "product", "id": "product", "label": "t:editor.text.product_fb9ef8" },
      { "type": "image_picker", "id": "image", "label": "t:vanity.image" },
      { "type": "textarea", "id": "note", "label": "t:editor.text.usage_guidance_0c1d12" }
    ]
  }],
  "presets": [{ "name": "t:vanity.name", "blocks": [{ "type": "product", "settings": { "step": "1" } },{ "type": "product", "settings": { "step": "2" } },{ "type": "product", "settings": { "step": "3" } }] }]
}
{% endschema %}

