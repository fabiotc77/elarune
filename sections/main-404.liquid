{%- capture premium_section_body -%}
{{ 'page-not-found.css' | asset_url | stylesheet_tag }}
<section class="page-not-found page-width section-space" aria-labelledby="NotFoundTitle-{{ section.id }}">
  <div class="page-not-found__intro">
    <p class="eyebrow">404</p>
    <h1 id="NotFoundTitle-{{ section.id }}">{{ 'general.not_found' | t }}</h1>
  </div>
  <div class="page-not-found__recovery">
    <p id="NotFoundHelp-{{ section.id }}">{{ 'search_page.start' | t }}</p>
    <label for="NotFoundSearch-{{ section.id }}">{{ 'general.search' | t }}</label>
    <form action="{{ routes.search_url }}" method="get" role="search" class="page-not-found__form">
      <input data-control="field" id="NotFoundSearch-{{ section.id }}" type="search" name="q" required aria-describedby="NotFoundHelp-{{ section.id }}">
      <button data-control="primary" class="button" type="submit">{{ 'general.search' | t }}</button>
    </form>
    <a data-control="text" class="text-link page-not-found__continue" href="{{ routes.all_products_collection_url }}">{{ 'general.continue' | t }} <span aria-hidden="true">↗</span></a>
  </div>
</section>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
