{%- capture premium_section_body -%}
{{ 'editorial-content.css' | asset_url | stylesheet_tag }}
{%- assign comment_form_id = 'Comments-' | append: section.id -%}
<div class="journal-article page-width section-space">
  <article aria-labelledby="Article-{{ section.id }}">
    <header class="journal-article__header">
      <a data-control="text" class="text-link" href="{{ blog.url }}">{{ 'editorial.back_to_blog' | t: blog: blog.title | escape }}</a>
      <h1 id="Article-{{ section.id }}">{{ article.title | escape }}</h1>
      <div class="journal__metadata">
        {%- if section.settings.show_date -%}{{ article.published_at | time_tag: format: 'abbreviated_date' }}{%- endif -%}
        {%- if section.settings.show_author and article.author != blank -%}<span>{{ article.author | escape }}</span>{%- endif -%}
      </div>
    </header>
    {%- if article.image != blank and section.settings.show_image -%}
      <div class="journal-article__image">{{ article.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '390, 750, 1100, 1440, 1800', sizes: '(min-width: 1440px) 1200px, 100vw' }}</div>
    {%- endif -%}
    <div class="journal-article__body rte">{{ article.content }}</div>
    {%- if section.settings.show_tags and article.tags != blank -%}
      <div class="journal-article__topics" aria-label="{{ 'editorial.tags' | t }}">
        <span class="eyebrow">{{ 'editorial.tags' | t }}</span>
        <ul>{%- for tag in article.tags -%}<li>{{ tag | escape }}</li>{%- endfor -%}</ul>
      </div>
    {%- endif -%}
  </article>
  {%- if article.comments_enabled? -%}
    <section class="journal-comments" aria-labelledby="{{ comment_form_id }}-title">
      <h2 id="{{ comment_form_id }}-title">{{ 'editorial.comments' | t }}</h2>
      {%- paginate article.comments by 20 -%}
        {%- if article.comments_count > 0 -%}
          <ol class="journal-comments__list">
            {%- for comment in article.comments -%}
              <li id="Comment-{{ section.id }}-{{ comment.id }}">
                <div class="journal__metadata"><span>{{ comment.author | escape }}</span>{{ comment.created_at | time_tag: format: 'abbreviated_date' }}</div>
                <div class="rte">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
      {%- form 'new_comment', article, id: comment_form_id, class: 'journal-comments__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="journal-comments__notice" role="status" tabindex="-1" autofocus>
            {%- if article.moderated? -%}{{ 'editorial.comment_pending' | t }}{%- else -%}{{ 'editorial.comment_success' | t }}{%- endif -%}
          </div>
        {%- elsif form.errors -%}
          <div class="journal-comments__notice" role="alert" tabindex="-1" autofocus aria-labelledby="{{ comment_form_id }}-errors">
            <h3 id="{{ comment_form_id }}-errors">{{ 'editorial.comment_error' | t }}</h3>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'author' or field == 'email' or field == 'body' -%}
                    <a href="#{{ comment_form_id }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</a>
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {%- if article.moderated? -%}<p class="journal-comments__wide muted">{{ 'editorial.moderation_notice' | t }}</p>{%- endif -%}
        {%- assign comment_fields = 'author,email,body' | split: ',' -%}
        {%- for field in comment_fields -%}
          {%- liquid
            case field
              when 'author'
                assign field_label = 'editorial.comment_name' | t
              when 'email'
                assign field_label = 'editorial.comment_email' | t
              when 'body'
                assign field_label = 'editorial.comment_body' | t
            endcase
          -%}
          <div class="journal-comments__field{% if field == 'body' %} journal-comments__wide{% endif %}">
            <label for="{{ comment_form_id }}-{{ field }}">{{ field_label }} <span aria-hidden="true">*</span></label>
            {%- if field == 'body' -%}
              <textarea data-control="field" id="{{ comment_form_id }}-{{ field }}" name="comment[body]" rows="6" required {% if form.errors contains field %}aria-invalid="true" aria-describedby="{{ comment_form_id }}-{{ field }}-error"{% endif %}>{{ form.body | escape }}</textarea>
            {%- else -%}
              <input data-control="field" id="{{ comment_form_id }}-{{ field }}" name="comment[{{ field }}]" value="{{ form[field] | escape }}" required
                {% if field == 'email' %}type="email" autocomplete="email" autocorrect="off" autocapitalize="off"{% else %}type="text" autocomplete="name"{% endif %}
                {% if form.errors contains field %}aria-invalid="true" aria-describedby="{{ comment_form_id }}-{{ field }}-error"{% endif %}>
            {%- endif -%}
            {%- if form.errors contains field -%}<p id="{{ comment_form_id }}-{{ field }}-error" class="journal-comments__error">{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
        <button data-control="primary" class="button journal-comments__submit" type="submit">{{ 'editorial.comment_send' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</div>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
