{%- comment -%}
  Cookie consent banner built on Shopify's Customer Privacy API.
  The banner opens only when customerPrivacy.shouldShowBanner() reports that this visitor must be asked,
  and records choices with setTrackingConsent(). Use it instead of Shopify's own banner (Settings > Customer privacy),
  never alongside it. Non-blocking; renders nothing visible without JavaScript because it cannot record consent.
{%- endcomment -%}
{%- liquid
  assign consent_render = section.settings.enabled
  if request.design_mode
    assign consent_render = true
  endif
  if request.page_type == 'password'
    assign consent_render = false
  endif
  assign consent_id = 'CookieConsent-' | append: section.id
  assign consent_position = section.settings.position | default: 'card'
  assign consent_heading = section.settings.heading
  if consent_heading == blank
    assign consent_heading = 'consent.heading' | t
  endif
  assign consent_policy_url = ''
  if section.settings.show_privacy_link and shop.privacy_policy.url != blank
    assign consent_policy_url = shop.privacy_policy.url
  endif
-%}
{%- if consent_render -%}
{% render 'section-scheme', section: section %}
{{ 'cookie-consent.css' | asset_url | stylesheet_tag }}
{%- capture consent_body -%}
  <div class="cookie-consent__layout">
    <div class="cookie-consent__copy">
      <h2 class="cookie-consent__heading" id="{{ consent_id }}-title" tabindex="-1">{{ consent_heading | escape }}</h2>
      <div class="cookie-consent__message rte" id="{{ consent_id }}-message">
        {%- if section.settings.message != blank -%}{{ section.settings.message }}{%- else -%}<p>{{ 'consent.message' | t }}</p>{%- endif -%}
      </div>
      {%- if consent_policy_url != blank -%}
        <a data-control="text" class="cookie-consent__policy" href="{{ consent_policy_url }}">{{ 'consent.privacy_policy' | t }}<span aria-hidden="true">↗</span></a>
      {%- endif -%}
    </div>
    {%- if section.settings.show_preferences -%}
      <div class="cookie-consent__preferences" id="{{ consent_id }}-panel" data-consent-panel hidden>
        <fieldset class="cookie-consent__fieldset">
          <legend class="cookie-consent__legend">{{ 'consent.preferences_title' | t }}</legend>
          <div class="cookie-consent__option">
            <div class="cookie-consent__option-copy">
              <label for="{{ consent_id }}-necessary">{{ 'consent.necessary' | t }}</label>
              <p id="{{ consent_id }}-necessary-info">{{ 'consent.necessary_description' | t }}</p>
            </div>
            <input class="cookie-consent__switch" type="checkbox" role="switch" id="{{ consent_id }}-necessary" checked disabled aria-describedby="{{ consent_id }}-necessary-info">
          </div>
          {%- for consent_field in (1..3) -%}
            {%- case consent_field -%}
              {%- when 1 -%}{%- assign consent_name = 'analytics' -%}
              {%- when 2 -%}{%- assign consent_name = 'marketing' -%}
              {%- else -%}{%- assign consent_name = 'preferences' -%}
            {%- endcase -%}
            {%- assign consent_label_key = 'consent.' | append: consent_name -%}
            {%- assign consent_info_key = consent_label_key | append: '_description' -%}
            <div class="cookie-consent__option">
              <div class="cookie-consent__option-copy">
                <label for="{{ consent_id }}-{{ consent_name }}">{{ consent_label_key | t }}</label>
                <p id="{{ consent_id }}-{{ consent_name }}-info">{{ consent_info_key | t }}</p>
              </div>
              <input class="cookie-consent__switch" type="checkbox" role="switch" id="{{ consent_id }}-{{ consent_name }}" data-consent-field="{{ consent_name }}" aria-describedby="{{ consent_id }}-{{ consent_name }}-info">
            </div>
          {%- endfor -%}
        </fieldset>
      </div>
    {%- endif -%}
    <div class="cookie-consent__actions">
      {%- if section.settings.show_preferences -%}
        <button data-control="text" class="cookie-consent__manage" type="button" data-consent-action="manage" aria-expanded="false" aria-controls="{{ consent_id }}-panel">{{ 'consent.manage' | t }}</button>
      {%- endif -%}
      <div class="cookie-consent__choices">
        <button data-control="secondary" type="button" data-consent-action="decline">{{ 'consent.decline' | t }}</button>
        <button data-control="secondary" type="button" data-consent-action="accept">{{ 'consent.accept' | t }}</button>
        {%- if section.settings.show_preferences -%}
          <button data-control="primary" class="cookie-consent__save" type="button" data-consent-action="save" hidden>{{ 'consent.save' | t }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endcapture -%}
<cookie-consent
  class="cookie-consent"
  data-position="{{ consent_position }}"
  data-section-id="{{ section.id }}"
  data-enabled="{{ section.settings.enabled }}"
  data-design-mode="{{ request.design_mode }}"
  data-saved="{{ 'consent.saved' | t | escape }}"
  data-error="{{ 'consent.error' | t | escape }}"
>
  {%- if consent_position == 'dialog' -%}
    <dialog class="cookie-consent__surface" aria-labelledby="{{ consent_id }}-title" aria-describedby="{{ consent_id }}-message" data-consent-surface>{{ consent_body }}</dialog>
  {%- else -%}
    <div class="cookie-consent__surface" role="region" aria-label="{{ 'consent.region' | t | escape }}" data-consent-surface hidden>{{ consent_body }}</div>
  {%- endif -%}
  <p class="visually-hidden" role="status" data-consent-status></p>
</cookie-consent>
<script src="{{ 'cookie-consent.js' | asset_url }}" type="module"></script>
{%- endif -%}
{% schema %}
{
  "name": "t:consent.name",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:consent.info"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "t:consent.enabled",
      "default": false
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:consent.position",
      "options": [
        {
          "value": "bar",
          "label": "t:consent.position_bar"
        },
        {
          "value": "card",
          "label": "t:consent.position_card"
        },
        {
          "value": "dialog",
          "label": "t:consent.position_dialog"
        }
      ],
      "default": "card"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:premium.heading",
      "default": "Your cookie choices"
    },
    {
      "type": "richtext",
      "id": "message",
      "label": "t:consent.message",
      "default": "<p>We use cookies and similar technologies to run this store and, with your consent, for analytics and marketing.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_privacy_link",
      "label": "t:consent.privacy_link",
      "info": "t:consent.privacy_link_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_preferences",
      "label": "t:consent.show_preferences",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:scheme.section",
      "default": "porcelain"
    }
  ],
  "presets": [
    {
      "name": "t:consent.name"
    }
  ]
}
{% endschema %}
