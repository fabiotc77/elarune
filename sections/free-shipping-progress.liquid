{%- capture premium_section_body -%}
{% liquid
  assign country_code = localization.country.iso_code
  assign currency_code = cart.currency.iso_code
  assign matching_rules = 0
  assign shipping_rule = nil
  for block in section.blocks
    assign rule_country = block.settings.country | strip | upcase
    assign rule_currency = block.settings.currency | strip | upcase
    if rule_country != blank and rule_currency != blank and rule_country == country_code and rule_currency == currency_code
      assign matching_rules = matching_rules | plus: 1
      assign shipping_rule = block
    endif
  endfor
  assign threshold = shipping_rule.settings.threshold | default: 0 | times: 100 | round
  assign supported_cart = cart.requires_shipping
  for item in cart.items
    unless item.requires_shipping
      assign supported_cart = false
    endunless
    if item.gift_card or item.selling_plan_allocation
      assign supported_cart = false
    endif
  endfor
  assign show_indicator = false
  if section.settings.enabled and matching_rules == 1 and threshold > 0 and supported_cart and cart.item_count > 0
    assign show_indicator = true
  endif
%}
{% if show_indicator %}
  {% liquid
    assign cart_total = cart.total_price | at_least: 0
    assign remaining = threshold | minus: cart_total | at_least: 0
    assign progress = cart_total | times: 100.0 | divided_by: threshold | at_most: 100
    assign remaining_money = remaining | money_with_currency | strip_html
    if remaining > 0
      assign shipping_message = 'free_shipping.remaining' | t: amount: remaining_money
    else
      assign shipping_message = 'free_shipping.reached' | t
    endif
    assign shipping_policy_url = section.settings.policy_url | default: shop.shipping_policy.url
    assign destination = localization.country.name | escape
  %}
  {{ 'free-shipping-progress.css' | asset_url | stylesheet_tag }}
  <section class="free-shipping-progress page-width" aria-labelledby="ShippingTitle-{{ section.id }}" {{ shipping_rule.shopify_attributes }}>
    <div class="free-shipping-progress__panel">
      <div class="free-shipping-progress__heading">
        <h2 id="ShippingTitle-{{ section.id }}">{{ 'free_shipping.title' | t }}</h2>
        <p class="free-shipping-progress__destination">{{ 'free_shipping.destination' | t: country: destination }}</p>
      </div>
      <p class="free-shipping-progress__message" id="ShippingMessage-{{ section.id }}">{{ shipping_message }}</p>
      <meter class="free-shipping-progress__meter" min="0" max="100" value="{{ progress }}" aria-labelledby="ShippingTitle-{{ section.id }}" aria-describedby="ShippingMessage-{{ section.id }}">{{ progress | round }}%</meter>
      <p class="free-shipping-progress__note">{{ 'free_shipping.checkout_note' | t }}</p>
      {% if shipping_rule.settings.conditions != blank %}<p class="free-shipping-progress__conditions">{{ shipping_rule.settings.conditions | escape }}</p>{% endif %}
      {% if shipping_policy_url != blank %}<a data-control="text" class="free-shipping-progress__policy text-link" href="{{ shipping_policy_url | escape }}">{{ 'free_shipping.policy' | t }}</a>{% endif %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="page-width"><p class="editor-note">{% if matching_rules > 1 %}{{ 'free_shipping.duplicate' | t }}{% else %}{{ 'free_shipping.setup' | t }}{% endif %}</p></div>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
