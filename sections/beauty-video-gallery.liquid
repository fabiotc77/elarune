{%- capture premium_section_body -%}
{% liquid
  assign video_count = 0
  for block in section.blocks
    if block.settings.video != blank
      assign video_count = video_count | plus: 1
    endif
  endfor
  assign gallery_heading = section.settings.heading
  if gallery_heading == blank
    assign gallery_heading = 'beauty_video_gallery.heading' | t
  endif
%}
{% if video_count > 0 or request.design_mode %}
  {{ 'beauty-video-gallery.css' | asset_url | stylesheet_tag }}
  <section class="beauty-video-gallery page-width section-space" aria-labelledby="VideoGalleryTitle-{{ section.id }}">
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="VideoGalleryTitle-{{ section.id }}">{{ gallery_heading | escape }}</h2>
      </div>
      {% if section.settings.introduction != blank %}<p class="muted">{{ section.settings.introduction | escape }}</p>{% endif %}
    </div>
    {% if video_count > 1 %}<p class="beauty-video-gallery__hint muted" id="VideoGalleryHint-{{ section.id }}">{{ 'beauty_video_gallery.scroll_hint' | t }}</p>{% endif %}
    <div class="beauty-video-gallery__rail"{% if video_count > 1 %} tabindex="0" role="region" aria-labelledby="VideoGalleryTitle-{{ section.id }}" aria-describedby="VideoGalleryHint-{{ section.id }}"{% endif %}>
      <ul class="beauty-video-gallery__list" role="list">
        {% for block in section.blocks %}
          {% if block.settings.video != blank %}
            {% liquid
              assign video_title = block.settings.title | default: block.settings.video.alt | default: gallery_heading
              assign video_title_id = 'GalleryVideoTitle-' | append: section.id | append: '-' | append: block.id
              assign linked_product = block.settings.product
            %}
            <li class="beauty-video-gallery__card" {{ block.shopify_attributes }}>
              <article aria-labelledby="{{ video_title_id }}">
                <div class="beauty-video-gallery__media">
                  {{ block.settings.video | video_tag: image_size: '600x', controls: true, autoplay: false, loop: false, muted: false, playsinline: true, preload: 'none', aria-labelledby: video_title_id }}
                </div>
                <div class="beauty-video-gallery__content">
                  <h3 id="{{ video_title_id }}">{{ video_title | escape }}</h3>
                  {% if block.settings.quote != blank %}
                    <figure class="beauty-video-gallery__quote">
                      <blockquote><p>{{ block.settings.quote | escape | newline_to_br }}</p></blockquote>
                      {% if block.settings.attribution != blank %}<figcaption>{{ block.settings.attribution | escape }}</figcaption>{% endif %}
                    </figure>
                  {% elsif block.settings.attribution != blank %}
                    <p class="beauty-video-gallery__attribution">{{ block.settings.attribution | escape }}</p>
                  {% endif %}
                  {% if block.settings.transcript != blank %}
                    <details class="beauty-video-gallery__transcript">
                      <summary data-control="disclosure">{{ 'beauty_video_gallery.transcript' | t }}</summary>
                      <div>{{ block.settings.transcript | escape | newline_to_br }}</div>
                    </details>
                  {% endif %}
                  {% if linked_product != blank %}
                    <a data-control="text" class="text-link beauty-video-gallery__product" href="{{ linked_product.url | escape }}">{{ 'beauty_video_gallery.shop_product' | t: product: linked_product.title | escape }}</a>
                  {% endif %}
                </div>
              </article>
            </li>
          {% elsif request.design_mode %}
            <li class="beauty-video-gallery__card beauty-video-gallery__empty" {{ block.shopify_attributes }}><p class="editor-note">{{ 'beauty_video_gallery.empty' | t }}</p></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    {% if request.design_mode and section.blocks.size == 0 %}<p class="editor-note">{{ 'beauty_video_gallery.empty' | t }}</p>{% endif %}
  </section>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
