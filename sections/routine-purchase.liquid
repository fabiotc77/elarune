{%- capture premium_section_body -%}
{% assign routine_count = 0 %}
{% assign purchasable_count = 0 %}
{% capture routine_items %}
  {% for block in section.blocks %}
    {% assign routine_product = block.settings.product %}
    {% if routine_product == blank %}{% continue %}{% endif %}
    {% liquid
      assign routine_count = routine_count | plus: 1
      assign can_purchase = true
      assign variant_count = routine_product.variants_count | default: routine_product.variants.size
      if routine_product.available == false or variant_count > 50 or variant_count == 0 or routine_product.gift_card? or routine_product.requires_selling_plan or routine_product.selling_plan_groups.size > 0
        assign can_purchase = false
      endif
      for routine_variant in routine_product.variants
        assign rule_min = routine_variant.quantity_rule.min | default: 1
        assign rule_step = routine_variant.quantity_rule.increment | default: 1
        if rule_min != 1 or rule_step != 1 or routine_variant.requires_selling_plan or routine_variant.requires_components
          assign can_purchase = false
        endif
        if routine_variant.quantity_rule.max != blank and routine_variant.quantity_rule.max < 1
          assign can_purchase = false
        endif
      endfor
      assign item_id = 'RoutineItem-' | append: section.id | append: '-' | append: block.id
      assign form_id = 'RoutineForm-' | append: section.id | append: '-' | append: block.id
    %}
    <li class="routine-purchase__item" {{ block.shopify_attributes }}>
      <div class="routine-purchase__image">
        {% if routine_product.featured_image %}
          {{ routine_product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720', sizes: '(min-width: 990px) 28vw, (min-width: 640px) 42vw, 88vw' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {% endif %}
      </div>
      <div class="routine-purchase__details">
        <span class="routine-purchase__number" aria-hidden="true">{% if routine_count < 10 %}0{% endif %}{{ routine_count }}</span>
        {% if block.settings.heading != blank %}<p class="eyebrow">{{ block.settings.heading | escape }}</p>{% endif %}
        <h3><a href="{{ routine_product.url | escape }}">{{ routine_product.title | escape }}</a></h3>
        {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
        {% if can_purchase %}
          {% assign purchasable_count = purchasable_count | plus: 1 %}
          <label class="routine-purchase__include" data-routine-enhanced hidden for="{{ item_id }}-include">
            <input data-control="check" id="{{ item_id }}-include" type="checkbox" data-routine-include aria-label="{{ 'routine_purchase.include' | t | escape }}: {{ routine_product.title | escape }}">
            {{ 'routine_purchase.include' | t }}
          </label>
          {% form 'product', routine_product, id: form_id, class: 'routine-purchase__form', data-routine-form: '' %}
            {{ form.errors | default_errors }}
            <input type="hidden" name="quantity" value="1">
            {% if routine_product.has_only_default_variant %}
              {% assign routine_variant = routine_product.variants.first %}
              <input type="hidden" name="id" value="{{ routine_variant.id }}">
              <p class="routine-purchase__price">{{ routine_variant.price | money_with_currency }}{% if routine_variant.unit_price_measurement and routine_variant.unit_price != nil %}<br><small>{{ routine_variant.unit_price | money_with_currency }} / {% if routine_variant.unit_price_measurement.reference_value != 1 %}{{ routine_variant.unit_price_measurement.reference_value }}{% endif %}{{ routine_variant.unit_price_measurement.reference_unit | escape }}</small>{% endif %}</p>
            {% else %}
              <label for="{{ item_id }}-variant">{{ 'product.variant' | t }}<span class="visually-hidden">: {{ routine_product.title | escape }}</span></label>
              <select data-control="field" id="{{ item_id }}-variant" name="id" required>
                <option value="" selected disabled>{{ 'product.variant' | t }}</option>
                {% for routine_variant in routine_product.variants %}
                  <option value="{{ routine_variant.id }}" {% unless routine_variant.available %}disabled{% endunless %}>{{ routine_variant.title | escape }} — {{ routine_variant.price | money_with_currency | escape }}{% if routine_variant.unit_price_measurement and routine_variant.unit_price != nil %} ({{ routine_variant.unit_price | money_with_currency | escape }} / {% if routine_variant.unit_price_measurement.reference_value != 1 %}{{ routine_variant.unit_price_measurement.reference_value }}{% endif %}{{ routine_variant.unit_price_measurement.reference_unit | escape }}){% endif %}{% unless routine_variant.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>
                {% endfor %}
              </select>
            {% endif %}
            <button data-control="secondary" class="button button--secondary" type="submit" name="add" data-routine-native aria-label="{{ 'product.add' | t | escape }}: {{ routine_product.title | escape }}">{{ 'product.add' | t }}</button>
          {% endform %}
        {% else %}
          {% unless routine_product.available %}<p>{{ 'product.sold_out' | t }}</p>{% endunless %}
          <a data-control="text" class="text-link" href="{{ routine_product.url | escape }}">{{ 'product_comparison.view_product' | t }}</a>
        {% endif %}
      </div>
    </li>
  {% endfor %}
{% endcapture %}
{% if routine_count > 0 %}
  {{ 'routine-purchase.css' | asset_url | stylesheet_tag }}
  {% if purchasable_count > 0 %}<script src="{{ 'routine-purchase.js' | asset_url }}" type="module"></script>{% endif %}
  <routine-purchase data-cart-url="{{ routes.cart_url }}" data-loading="{{ 'cart_upsell.adding' | t | escape }}" data-uncertain="{{ 'routine_purchase.uncertain' | t | escape }}" data-instruction="{{ 'routine_purchase.instruction' | t | escape }}">
    <section class="routine-purchase page-width section-space" aria-labelledby="RoutinePurchase-{{ section.id }}">
      <div class="section-heading">
        <h2 id="RoutinePurchase-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'routine_purchase.title' | t }}{% endif %}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text | escape }}</p>{% endif %}
      </div>
      <ul class="routine-purchase__grid" role="list">{{ routine_items }}</ul>
      {% if purchasable_count > 0 %}
        <div class="routine-purchase__actions" data-routine-enhanced hidden>
          <p>{{ 'routine_purchase.instruction' | t }}</p>
          <button data-control="primary" type="button" class="button" data-routine-add>{{ 'routine_purchase.add_selected' | t }}</button>
        </div>
        <div class="routine-purchase__notice">
          <p data-routine-message role="status" aria-live="polite" aria-atomic="true"></p>
          <a data-control="text" class="text-link" data-routine-review href="{{ routes.cart_url }}" hidden>{{ 'cart_upsell.review' | t }}</a>
        </div>
      {% endif %}
    </section>
  </routine-purchase>
{% elsif request.design_mode %}
  <div class="page-width"><p class="editor-note">{{ 'routine_purchase.empty' | t }}</p></div>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
