{{ 'password.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign password_id = 'StorePassword-' | append: section.id
  assign password_title = 'password_page.title' | t
-%}
<section class="password-page page-width{% if section.settings.image != blank %} password-page--with-image{% endif %}" aria-labelledby="{{ password_id }}-title">
  <div class="password-page__content">
    <p class="brand password-page__brand">{{ shop.name | escape }}</p>
    <h1 id="{{ password_id }}-title">{{ section.settings.heading | default: password_title | escape }}</h1>
    {%- if shop.password_message != blank -%}<div class="password-page__message rte">{{ shop.password_message }}</div>{%- endif -%}
    <p class="muted">{{ 'password_page.introduction' | t }}</p>
    {%- form 'storefront_password', id: password_id, class: 'password-page__form' -%}
      {%- if form.errors -%}
        <div id="{{ password_id }}-error" class="password-page__error" role="alert" tabindex="-1" autofocus>
          <h2>{{ 'password_page.error_heading' | t }}</h2>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="password-page__field">
        <label for="{{ password_id }}-input">{{ 'password_page.password' | t }}</label>
        <input data-control="field" id="{{ password_id }}-input" type="password" name="password" autocomplete="current-password" required
          {% if form.errors %}aria-invalid="true" aria-describedby="{{ password_id }}-error"{% endif %}>
      </div>
      <button data-control="primary" type="submit" class="button">{{ 'password_page.enter' | t }}</button>
    {%- endform -%}
    <a data-control="text" class="text-link password-page__owner" href="{{ shop.url }}/admin">{{ 'password_page.owner' | t }}</a>
  </div>
  {%- if section.settings.image != blank -%}
    <div class="password-page__image">{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '390, 750, 1100, 1600', sizes: '(min-width: 750px) 50vw, 100vw' }}</div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "t:editor.text.password_page_63f645",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:editor.text.heading_b34f17"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:editor.text.campaign_image_e11542"
    }
  ]
}
{% endschema %}
