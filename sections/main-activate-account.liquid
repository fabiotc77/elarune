{{ 'customer.css' | asset_url | stylesheet_tag }}
<section class="customer page-width section-space" aria-labelledby="CustomerActivate-{{ section.id }}-title">
  <div class="customer__panel">
    <h1 class="customer__title" id="CustomerActivate-{{ section.id }}-title">{{ 'customer.activate_account.title' | t }}</h1>
    <p class="customer__intro">{{ 'customer.activate_account.subtext' | t }}</p>
    <div class="customer__pane">
      {%- form 'activate_customer_password', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="customer__notice customer__notice--error" role="alert" tabindex="-1" autofocus>
            <ul class="customer__error-list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="customer__field">
          <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
          <input data-control="field" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        </div>
        <div class="customer__field">
          <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input data-control="field" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        </div>
        <div class="customer__actions">
          <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.activate_account.submit' | t }}</button>
          <button data-control="secondary" class="button button--secondary" name="decline" type="submit">{{ 'customer.activate_account.decline' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"t:customer.activate_account.name","tag":"section","settings":[]}
{% endschema %}
