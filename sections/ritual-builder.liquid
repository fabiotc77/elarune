    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:ritual_builder.label_3",
      "settings": [
        {
          "type": "select",
          "id": "step",
          "label": "t:ritual_builder.label_4",
          "options": [
            {
              "value": "1",
              "label": "t:ritual_builder.label_5"
            },
            {
