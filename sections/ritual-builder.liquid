        {
          "type": "product",
          "id": "product",
          "label": "t:ritual_builder.label_8"
        },
        {
          "type": "text",
          "id": "needs",
          "label": "t:ritual_builder.label_9",
          "info": "t:ritual_builder.label_10"
        },
        {
          "type": "text",
