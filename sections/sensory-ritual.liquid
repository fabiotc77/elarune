{%- capture premium_section_body -%}
{{ 'sensory-home.css' | asset_url | stylesheet_tag }}
{{ 'sensory-motion.css' | asset_url | stylesheet_tag }}
{{ 'sensory-discovery.css' | asset_url | stylesheet_tag }}
{% if section.settings.editorial_composition %}{{ 'sensory-editorial.css' | asset_url | stylesheet_tag }}{% endif %}
<script src="{{ 'sensory-motion.js' | asset_url }}" type="module"></script>
<sensory-scene data-editorial="{{ section.settings.editorial_composition }}" data-scene="ritual">
<script src="{{ 'sensory-ritual.js' | asset_url }}" type="module"></script>
<sensory-ritual class="sensory sensory-ritual" id="routine">
  <div class="sensory-ritual-intro"><p class="sensory-kicker">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h2><p>{{ section.settings.text | escape }}</p>{% if section.settings.editorial_composition %}<div class="sensory-ritual-visual" data-ritual-visual aria-hidden="true" hidden></div>{% endif %}<span class="sensory-ritual-seal" aria-hidden="true"><svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="45"/><path d="M50 23c-8 13-17 23-17 34a17 17 0 0 0 34 0c0-11-9-21-17-34Z"/><path d="M43 62q8 9 15-1"/></svg></span></div>
  <div class="sensory-ritual-content"><div class="sensory-ritual-tabs" hidden><button data-control="choice" type="button" data-period="morning" aria-pressed="true">{{ 'beauty.morning' | t }} <span aria-hidden="true">☼</span></button><button data-control="choice" type="button" data-period="evening" aria-pressed="false">{{ 'beauty.evening' | t }} <span aria-hidden="true">☾</span></button></div>
    {% for block in section.blocks %}{% assign item = block.settings.product %}<details class="sensory-ritual-step" data-step-period="{{ block.settings.period }}" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}><summary data-control="disclosure"><span class="sensory-step-mark" aria-hidden="true">{{ forloop.index }}</span><span>{{ block.settings.heading | escape }}</span><span class="sensory-step-plus" aria-hidden="true">＋</span></summary><div class="sensory-step-body">{% if item.featured_image != blank %}<a href="{{ item.url }}">{{ item.featured_image | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '(min-width: 750px) 16vw, 35vw', loading: 'lazy' }}</a>{% endif %}<div><p>{{ block.settings.text | escape }}</p>{% if item != blank %}<h3>{{ item.title | escape }}</h3>{% render 'price', target: item, show_from: true, show_compare: false %}<a data-control="text" class="sensory-text-link" href="{{ item.url }}">{{ 'product_comparison.view_product' | t }} <span aria-hidden="true">↗</span></a>{% endif %}</div></div></details>{% endfor %}
  </div>
</sensory-ritual>
</sensory-scene>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
