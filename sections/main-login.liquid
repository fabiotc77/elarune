{{ 'customer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign form_id = 'CustomerLogin-' | append: section.id
-%}
<section class="customer page-width section-space" aria-labelledby="{{ form_id }}-title">
  <div class="customer__panel">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow customer__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="customer__title" id="{{ form_id }}-title">{{ 'customer.login.title' | t }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="customer__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- if shop.customer_accounts_enabled == false -%}
      <p class="customer__intro">{{ 'customer.login.disabled' | t }}</p>
    {%- else -%}
      <div id="RecoverPassword" class="customer__pane" tabindex="-1">
        {%- form 'recover_customer_password', class: 'customer__form' -%}
          <h2 class="customer__subtitle">{{ 'customer.recover_password.title' | t }}</h2>
          <p class="customer__note">{{ 'customer.recover_password.subtext' | t }}</p>
          {%- if form.posted_successfully? -%}
            <p class="customer__notice" role="status" tabindex="-1" autofocus>{{ 'customer.recover_password.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="customer__notice customer__notice--error" role="alert" tabindex="-1" autofocus>
              <ul class="customer__error-list">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="customer__field">
            <label for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input data-control="field" type="email" name="email" id="RecoverEmail" autocomplete="email" autocorrect="off" autocapitalize="off" spellcheck="false" required>
          </div>
          <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.recover_password.submit' | t }}</button>
          <a data-control="text" class="text-link customer__switch" href="#CustomerLoginForm" data-customer-toggle="login">{{ 'customer.recover_password.cancel' | t }}</a>
        {%- endform -%}
      </div>

      <div id="CustomerLoginForm" class="customer__pane" tabindex="-1">
        {%- form 'customer_login', class: 'customer__form' -%}
          {%- if form.errors -%}
            <div class="customer__notice customer__notice--error" role="alert" tabindex="-1" autofocus>
              <ul class="customer__error-list">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="customer__field">
            <label for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
            <input data-control="field" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" spellcheck="false" required>
          </div>
          <div class="customer__field">
            <label for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input data-control="field" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
          </div>
          <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.login.submit' | t }}</button>
          <a data-control="text" class="text-link customer__switch" href="#RecoverPassword" data-customer-toggle="recover">{{ 'customer.login.forgot' | t }}</a>
        {%- endform -%}
        <p class="customer__alt">
          {{ 'customer.login.no_account' | t }}
          <a data-control="text" class="text-link" href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a>
        </p>
      </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>
{% schema %}
{"name":"t:customer.login.name","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"t:editor.text.eyebrow_d821dd","default":"Account"},{"type":"textarea","id":"intro","label":"t:editor.text.description_526e00"}]}
{% endschema %}
