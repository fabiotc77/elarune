{{ 'customer.css' | asset_url | stylesheet_tag }}
<section class="customer customer--addresses page-width section-space" aria-labelledby="CustomerAddresses-{{ section.id }}-title">
  <header class="customer__header">
    <div>
      <p class="eyebrow customer__eyebrow">{{ 'customer.account.title' | t }}</p>
      <h1 class="customer__title" id="CustomerAddresses-{{ section.id }}-title">{{ 'customer.addresses.title' | t }}</h1>
    </div>
    <a data-control="text" class="text-link" href="{{ routes.account_url }}">{{ 'customer.order.return' | t }}</a>
  </header>

  {%- paginate customer.addresses by 6 -%}
    <div class="customer__pane">
      <h2 class="customer__subtitle">{{ 'customer.addresses.add_new' | t }}</h2>
      {%- form 'customer_address', customer.new_address, class: 'customer__form customer__form--address' -%}
        <div class="customer__field-row">
          <div class="customer__field">
            <label for="AddressFirstNameNew">{{ 'customer.register.first_name' | t }}</label>
            <input data-control="field" type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
          </div>
          <div class="customer__field">
            <label for="AddressLastNameNew">{{ 'customer.register.last_name' | t }}</label>
            <input data-control="field" type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
          </div>
        </div>
        <div class="customer__field">
          <label for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
          <input data-control="field" type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" autocomplete="organization">
        </div>
        <div class="customer__field">
          <label for="AddressAddress1New">{{ 'customer.addresses.address1' | t }}</label>
          <input data-control="field" type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
        </div>
        <div class="customer__field">
          <label for="AddressAddress2New">{{ 'customer.addresses.address2' | t }}</label>
          <input data-control="field" type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
        </div>
        <div class="customer__field-row">
          <div class="customer__field">
            <label for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
            <input data-control="field" type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
          </div>
          <div class="customer__field">
            <label for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
            <input data-control="field" type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code" autocapitalize="characters">
          </div>
        </div>
        <div class="customer__field-row">
          <div class="customer__field">
            <label for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
            <select data-control="field" id="AddressCountryNew" name="address[country]" data-address-country data-default="{{ form.country }}" autocomplete="country">{{ country_option_tags }}</select>
          </div>
          <div class="customer__field" id="AddressProvinceContainerNew" data-address-province-container hidden>
            <label for="AddressProvinceNew">{{ 'customer.addresses.province' | t }}</label>
            <select data-control="field" id="AddressProvinceNew" name="address[province]" data-address-province data-default="{{ form.province }}" autocomplete="address-level1"></select>
          </div>
        </div>
        <div class="customer__field">
          <label for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
          <input data-control="field" type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
        </div>
        <div class="customer__checkbox">
          <input data-control="check" type="checkbox" id="AddressSetDefaultNew" name="address[default]" value="1">
          <label for="AddressSetDefaultNew">{{ 'customer.addresses.set_default' | t }}</label>
        </div>
        <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.addresses.add' | t }}</button>
      {%- endform -%}
    </div>

    {%- if customer.addresses.size > 0 -%}
      <ul class="customer__address-list" role="list">
        {%- for address in customer.addresses -%}
          <li class="customer__address-card">
            {%- if address == customer.default_address -%}
              <p class="customer__badge">{{ 'customer.addresses.default' | t }}</p>
            {%- endif -%}
            <address class="customer__address">{{ address | format_address }}</address>
            <div class="customer__actions">
              <a data-control="secondary" class="button button--secondary" href="{{ routes.account_addresses_url }}#EditAddress-{{ address.id }}">{{ 'customer.addresses.edit' | t }}</a>
              {%- form 'customer_address', address -%}
                <input type="hidden" name="_method" value="delete">
                <button data-control="text" class="text-link" type="submit">{{ 'customer.addresses.delete' | t }}</button>
              {%- endform -%}
            </div>
            <details class="customer__edit" id="EditAddress-{{ address.id }}">
              <summary data-control="disclosure">{{ 'customer.addresses.edit' | t }}</summary>
              {%- form 'customer_address', address, class: 'customer__form customer__form--address' -%}
                <div class="customer__field-row">
                  <div class="customer__field">
                    <label for="AddressFirstName-{{ address.id }}">{{ 'customer.register.first_name' | t }}</label>
                    <input data-control="field" type="text" id="AddressFirstName-{{ address.id }}" name="address[first_name]" value="{{ address.first_name }}" autocomplete="given-name">
                  </div>
                  <div class="customer__field">
                    <label for="AddressLastName-{{ address.id }}">{{ 'customer.register.last_name' | t }}</label>
                    <input data-control="field" type="text" id="AddressLastName-{{ address.id }}" name="address[last_name]" value="{{ address.last_name }}" autocomplete="family-name">
                  </div>
                </div>
                <div class="customer__field">
                  <label for="AddressCompany-{{ address.id }}">{{ 'customer.addresses.company' | t }}</label>
                  <input data-control="field" type="text" id="AddressCompany-{{ address.id }}" name="address[company]" value="{{ address.company }}" autocomplete="organization">
                </div>
                <div class="customer__field">
                  <label for="AddressAddress1-{{ address.id }}">{{ 'customer.addresses.address1' | t }}</label>
                  <input data-control="field" type="text" id="AddressAddress1-{{ address.id }}" name="address[address1]" value="{{ address.address1 }}" autocomplete="address-line1">
                </div>
                <div class="customer__field">
                  <label for="AddressAddress2-{{ address.id }}">{{ 'customer.addresses.address2' | t }}</label>
                  <input data-control="field" type="text" id="AddressAddress2-{{ address.id }}" name="address[address2]" value="{{ address.address2 }}" autocomplete="address-line2">
                </div>
                <div class="customer__field-row">
                  <div class="customer__field">
                    <label for="AddressCity-{{ address.id }}">{{ 'customer.addresses.city' | t }}</label>
                    <input data-control="field" type="text" id="AddressCity-{{ address.id }}" name="address[city]" value="{{ address.city }}" autocomplete="address-level2">
                  </div>
                  <div class="customer__field">
                    <label for="AddressZip-{{ address.id }}">{{ 'customer.addresses.zip' | t }}</label>
                    <input data-control="field" type="text" id="AddressZip-{{ address.id }}" name="address[zip]" value="{{ address.zip }}" autocomplete="postal-code" autocapitalize="characters">
                  </div>
                </div>
                <div class="customer__field-row">
                  <div class="customer__field">
                    <label for="AddressCountry-{{ address.id }}">{{ 'customer.addresses.country' | t }}</label>
                    <select data-control="field" id="AddressCountry-{{ address.id }}" name="address[country]" data-address-country data-default="{{ address.country }}" autocomplete="country">{{ country_option_tags }}</select>
                  </div>
                  <div class="customer__field" id="AddressProvinceContainer-{{ address.id }}" data-address-province-container hidden>
                    <label for="AddressProvince-{{ address.id }}">{{ 'customer.addresses.province' | t }}</label>
                    <select data-control="field" id="AddressProvince-{{ address.id }}" name="address[province]" data-address-province data-default="{{ address.province }}" autocomplete="address-level1"></select>
                  </div>
                </div>
                <div class="customer__field">
                  <label for="AddressPhone-{{ address.id }}">{{ 'customer.addresses.phone' | t }}</label>
                  <input data-control="field" type="tel" id="AddressPhone-{{ address.id }}" name="address[phone]" value="{{ address.phone }}" autocomplete="tel">
                </div>
                <div class="customer__checkbox">
                  <input data-control="check" type="checkbox" id="AddressSetDefault-{{ address.id }}" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %}>
                  <label for="AddressSetDefault-{{ address.id }}">{{ 'customer.addresses.set_default' | t }}</label>
                </div>
                <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.addresses.update' | t }}</button>
              {%- endform -%}
            </details>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- else -%}
      <p class="customer__note">{{ 'customer.addresses.none' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
<script src="{{ 'customer.js' | asset_url }}" defer="defer"></script>
{% schema %}
{"name":"t:customer.addresses.name","tag":"section","settings":[]}
{% endschema %}
