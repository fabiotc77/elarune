{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign image = section.settings.image
  assign image_2 = section.settings.image_2

  case section.settings.image_width
    when 'third'
      assign image_sizes = '(min-width: 1440px) 460px, (min-width: 990px) 32vw, (min-width: 750px) 40vw, 100vw'
      assign second_sizes = '(min-width: 990px) 16vw, (min-width: 750px) 20vw, 44vw'
    when 'two_thirds'
      assign image_sizes = '(min-width: 1440px) 900px, (min-width: 990px) 62vw, (min-width: 750px) 58vw, 100vw'
      assign second_sizes = '(min-width: 990px) 26vw, (min-width: 750px) 24vw, 44vw'
    else
      assign image_sizes = '(min-width: 1440px) 680px, (min-width: 990px) 48vw, (min-width: 750px) 50vw, 100vw'
      assign second_sizes = '(min-width: 990px) 20vw, (min-width: 750px) 21vw, 44vw'
  endcase

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '3 / 2'
    else
      assign ratio = '4 / 5'
      if image != blank
        assign ratio = image.aspect_ratio
      endif
  endcase
  assign ratio_2 = ratio
  if section.settings.image_ratio == 'natural' and image_2 != blank
    assign ratio_2 = image_2.aspect_ratio
  endif

  assign image_loading = 'lazy'
  if section.index == 1
    assign image_loading = 'eager'
  endif

  assign heading_id = ''
  assign first_heading = section.blocks | where: 'type', 'heading' | first
  if first_heading and first_heading.settings.heading != blank
    assign heading_id = 'ImageWithText-' | append: section.id | append: '-' | append: first_heading.id
  endif
-%}
<section class="image-with-text page-width section-space" data-image-width="{{ section.settings.image_width }}" data-image-position="{{ section.settings.image_position }}" data-align="{{ section.settings.vertical_alignment }}" data-mobile-order="{{ section.settings.mobile_order }}"{% if image_2 != blank %} data-overlap{% endif %}{% if heading_id != '' %} aria-labelledby="{{ heading_id }}"{% endif %}>
  <div class="image-with-text__media premium-reveal">
    <div class="image-with-text__frame" style="--iwt-ratio:{{ ratio }}">
      {%- if image != blank -%}
        {{ image | image_url: width: 2000 | image_tag: widths: '375, 550, 750, 1000, 1250, 1500, 2000', sizes: image_sizes, loading: image_loading, class: 'image-with-text__image' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg image-with-text__image' }}
      {%- endif -%}
    </div>
    {%- if image_2 != blank -%}
      <div class="image-with-text__frame image-with-text__frame--secondary" style="--iwt-ratio:{{ ratio_2 }}">
        {{ image_2 | image_url: width: 1000 | image_tag: widths: '240, 360, 480, 720, 1000', sizes: second_sizes, loading: 'lazy', class: 'image-with-text__image' }}
      </div>
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="image-with-text__content premium-reveal">
      {%- assign skip_until = -1 -%}
      {%- for block in section.blocks -%}
        {%- if forloop.index0 <= skip_until -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign group_start = forloop.index0 -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <p class="eyebrow image-with-text__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 id="ImageWithText-{{ section.id }}-{{ block.id }}" class="image-with-text__heading image-with-text__heading--{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rte image-with-text__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}
          {%- when 'button' -%}
            {%- comment -%} Consecutive buttons share one wrapping row. {%- endcomment -%}
            <div class="image-with-text__actions">
              {%- for item in section.blocks offset: group_start -%}
                {%- if item.type != 'button' -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign skip_until = group_start | plus: forloop.index0 -%}
                {%- if item.settings.label != blank -%}
                  <a data-control="{{ item.settings.style }}"{% if item.settings.style == 'text' %} class="text-link"{% endif %}{% if item.settings.link != blank %} href="{{ item.settings.link }}"{% else %} role="link" aria-disabled="true"{% endif %} {{ item.shopify_attributes }}>{{ item.settings.label | escape }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'detail' -%}
            {%- comment -%} Consecutive details render as one definition list. {%- endcomment -%}
            <dl class="image-with-text__details">
              {%- for item in section.blocks offset: group_start -%}
                {%- if item.type != 'detail' -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign skip_until = group_start | plus: forloop.index0 -%}
                {%- if item.settings.label != blank or item.settings.value != blank -%}
                  <div class="image-with-text__detail" {{ item.shopify_attributes }}>
                    <dt>{{ item.settings.label | escape }}</dt>
                    <dd>{{ item.settings.value | escape }}</dd>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </dl>
          {%- when 'caption' -%}
            {%- if block.settings.text != blank -%}
              <p class="image-with-text__caption" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
