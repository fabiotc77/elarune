{%- capture premium_section_body -%}
{% if section.settings.image != blank or section.settings.heading != blank %}
  {{ 'brand-story.css' | asset_url | stylesheet_tag }}
  {% assign story_has_image = false %}
  {% if section.settings.image != blank %}{% assign story_has_image = true %}{% endif %}
  <section id="philosophy" class="brand-story{% if request.page_type == 'product' %} brand-story--product{% endif %}{% unless story_has_image %} brand-story--text-only{% endunless %}"{% if section.settings.heading != blank %} aria-labelledby="Story-{{ section.id }}"{% endif %} style="--story-background:{{ section.settings.background }};--story-text:{{ section.settings.text_color }}">
    {% if story_has_image %}
      <div class="brand-story-image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 1920px) 760px, (min-width: 990px) 42vw, 100vw', loading: 'lazy', alt: section.settings.heading }}
        {% endif %}
      </div>
    {% endif %}
    <div class="brand-story-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="Story-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      {% capture story_details %}
        {% assign detail_number = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.label != blank and block.settings.value != blank %}
            {% assign detail_number = detail_number | plus: 1 %}
            <div class="brand-story-detail" {{ block.shopify_attributes }}>
              <dt><span class="brand-story-number" aria-hidden="true">0{{ detail_number }}</span><span>{{ block.settings.label | escape }}</span></dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {% endif %}
        {% endfor %}
      {% endcapture %}
      {% assign story_details = story_details | strip %}
      {% if story_details != blank %}<dl class="brand-story-details">{{ story_details }}</dl>{% endif %}
      {% if section.settings.link != blank and section.settings.link_label != blank %}<a data-control="text" class="brand-story-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
  </section>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
