{%- capture premium_section_body -%}
{{ 'beauty.css' | asset_url | stylesheet_tag }}
{% if section.blocks.size > 0 %}<section class="page-width section-space" aria-labelledby="Evidence-{{ section.id }}">
  <div class="section-heading"><h2 id="Evidence-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p class="muted">{{ section.settings.context | escape }}</p></div>
  <div class="evidence-grid">{% for block in section.blocks %}<article class="evidence-card" {{ block.shopify_attributes }}>
    {% if block.settings.value != blank %}<p class="evidence-value">{{ block.settings.value | escape }}</p>{% endif %}<h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.description }}</div>
    {% if block.settings.method != blank %}<p class="beauty-disclaimer">{{ block.settings.method | escape }}</p>{% endif %}
    {% if block.settings.source != blank and block.settings.source_label != blank %}<a data-control="text" class="text-link" href="{{ block.settings.source }}">{{ block.settings.source_label | escape }}</a>{% endif %}
    {% if request.design_mode and block.settings.method == blank %}<p class="editor-note">{{ 'results_timeline.editor_method' | t }}</p>{% endif %}
  </article>{% endfor %}</div>
  {% if section.settings.disclaimer != blank %}<p class="beauty-disclaimer">{{ section.settings.disclaimer | escape }}</p>{% endif %}
</section>{% elsif request.design_mode %}<aside class="page-width editor-note">{{ 'results_timeline.editor_empty' | t }}</aside>{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
