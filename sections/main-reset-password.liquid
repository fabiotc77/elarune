{{ 'customer.css' | asset_url | stylesheet_tag }}
<section class="customer page-width section-space" aria-labelledby="CustomerReset-{{ section.id }}-title">
  <div class="customer__panel">
    <h1 class="customer__title" id="CustomerReset-{{ section.id }}-title">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="customer__intro">{{ 'customer.reset_password.subtext' | t }}</p>
    <div class="customer__pane">
      {%- form 'reset_customer_password', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="customer__notice customer__notice--error" role="alert" tabindex="-1" autofocus>
            <ul class="customer__error-list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="customer__field">
          <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input data-control="field" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>
        <div class="customer__field">
          <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input data-control="field" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
        </div>
        <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"t:customer.reset_password.name","tag":"section","settings":[]}
{% endschema %}
