{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
{% assign featured = section.settings.collection %}
{% assign card_products = section.settings.products %}
{% if card_products == blank or card_products.size == 0 %}
  {% assign card_products = featured.products %}
{% endif %}
{% if card_products.size > 0 or featured.products_count > 0 %}
  <section class="page-width section-space" aria-labelledby="Collection-{{ section.id }}">
    <div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="Collection-{{ section.id }}">{{ section.settings.heading | default: featured.title | escape }}</h2></div><a data-control="secondary" class="featured-view-all-btn text-link" href="{{ featured.url | default: routes.all_products_collection_url }}"><span>{{ 'general.view_all' | t }}</span> <span class="view-all-arrow" aria-hidden="true">↗</span></a></div>
    <div class="product-grid" style="--product-columns:{{ section.settings.columns }}">{% for card_product in card_products limit: section.settings.limit %}{% render 'product-card', card_product: card_product %}{% endfor %}</div>
  </section>
{% endif %}
{% render 'launch-check', source_section: section, kind: 'featured' %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
