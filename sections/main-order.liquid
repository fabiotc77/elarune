{{ 'customer.css' | asset_url | stylesheet_tag }}
<section class="customer customer--order page-width section-space" aria-labelledby="CustomerOrder-{{ section.id }}-title">
  <header class="customer__header">
    <div>
      <p class="eyebrow customer__eyebrow">{{ 'customer.orders.title' | t }}</p>
      <h1 class="customer__title" id="CustomerOrder-{{ section.id }}-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
      <p class="customer__note">{{ 'customer.order.date' | t: date: order.created_at | date: format: 'date' }}</p>
    </div>
    <a data-control="text" class="text-link" href="{{ routes.account_url }}">{{ 'customer.order.return' | t }}</a>
  </header>

  {%- if order.cancelled -%}
    <div class="customer__notice customer__notice--error" role="status">
      <p>{{ 'customer.order.cancelled' | t: date: order.cancelled_at | date: format: 'date' }}</p>
      {%- if order.cancel_reason != blank -%}<p>{{ order.cancel_reason_label }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="customer__table-scroll">
    <table class="customer__table customer__table--order">
      <caption class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ 'customer.order.product' | t }}</th>
          <th scope="col">{{ 'customer.order.sku' | t }}</th>
          <th scope="col">{{ 'customer.order.price' | t }}</th>
          <th scope="col">{{ 'customer.order.quantity' | t }}</th>
          <th scope="col">{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <th scope="row" data-label="{{ 'customer.order.product' | t | escape }}">
              {%- if line_item.url != blank -%}
                <a data-control="text" class="text-link" href="{{ line_item.url }}">{{ line_item.title | escape }}</a>
              {%- else -%}
                {{ line_item.title | escape }}
              {%- endif -%}
              {%- if line_item.fulfillment -%}
                <span class="customer__meta">{{ 'customer.order.fulfilled_at' | t: date: line_item.fulfillment.created_at | date: format: 'date' }}</span>
              {%- endif -%}
            </th>
            <td data-label="{{ 'customer.order.sku' | t | escape }}">{{ line_item.sku }}</td>
            <td data-label="{{ 'customer.order.price' | t | escape }}">{{ line_item.final_price | money }}</td>
            <td data-label="{{ 'customer.order.quantity' | t | escape }}">{{ line_item.quantity }}</td>
            <td data-label="{{ 'customer.order.total' | t | escape }}">{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="4">{{ 'customer.order.subtotal' | t }}</th>
          <td data-label="{{ 'customer.order.subtotal' | t | escape }}">{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {%- for discount_application in order.cart_level_discount_applications -%}
          <tr>
            <th scope="row" colspan="4">{{ discount_application.title | escape }}</th>
            <td>-{{ discount_application.total_allocated_amount | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <th scope="row" colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title | escape }})</th>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <th scope="row" colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</th>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr class="customer__table-total">
          <th scope="row" colspan="4">{{ 'customer.order.total' | t }}</th>
          <td>{{ order.total_net_amount | money_with_currency }}</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="customer__layout customer__layout--addresses">
    <div>
      <h2 class="customer__subtitle">{{ 'customer.order.billing_address' | t }}</h2>
      <p class="customer__note">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
      <address class="customer__address">{{ order.billing_address | format_address }}</address>
    </div>
    <div>
      <h2 class="customer__subtitle">{{ 'customer.order.shipping_address' | t }}</h2>
      <p class="customer__note">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
      <address class="customer__address">{{ order.shipping_address | format_address }}</address>
    </div>
  </div>
</section>
{% schema %}
{"name":"t:customer.order.name","tag":"section","settings":[]}
{% endschema %}
