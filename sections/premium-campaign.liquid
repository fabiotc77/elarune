  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:premium.heading"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "t:premium.mode",
      "options": [
        {
          "value": "full",
          "label": "t:premium.full"
        },
        {
          "value": "split",
          "label": "t:premium.split"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:premium.height",
