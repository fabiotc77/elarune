        {
          "value": "large",
          "label": "t:premium.large"
        },
        {
          "value": "viewport",
          "label": "t:premium.viewport"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:premium.position",
      "options": [
        {
          "value": "top_left",
          "label": "t:premium.top_left"
        },
        {
          "value": "center_left",
          "label": "t:premium.center_left"
        },
        {
          "value": "bottom_left",
          "label": "t:premium.bottom_left"
        },
        {
          "value": "center",
          "label": "t:premium.center"
        },
        {
          "value": "bottom_center",
          "label": "t:premium.bottom_center"
        },
        {
          "value": "top_right",
          "label": "t:premium.top_right"
        },
        {
          "value": "center_right",
          "label": "t:premium.center_right"
        },
        {
          "value": "bottom_right",
          "label": "t:premium.bottom_right"
        }
      ],
      "default": "center_left"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "label": "t:premium.mobile_position",
      "options": [
        {
          "value": "top_left",
          "label": "t:premium.top_left"
        },
        {
          "value": "center_left",
          "label": "t:premium.center_left"
        },
        {
          "value": "bottom_left",
          "label": "t:premium.bottom_left"
        },
        {
          "value": "center",
          "label": "t:premium.center"
        },
        {
          "value": "bottom_center",
          "label": "t:premium.bottom_center"
        },
        {
          "value": "top_right",
          "label": "t:premium.top_right"
        },
        {
          "value": "center_right",
          "label": "t:premium.center_right"
        },
        {
          "value": "bottom_right",
          "label": "t:premium.bottom_right"
        }
