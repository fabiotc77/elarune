{%- capture premium_section_body -%}
{{ 'premium-editorial.css' | asset_url | stylesheet_tag }}
<premium-campaign data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" class="premium-campaign" data-layout="{{ section.settings.mode }}" data-height="{{ section.settings.height }}" data-position="{{ section.settings.position }}" data-mobile-position="{{ section.settings.mobile_position }}" style="--campaign-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--campaign-transition:{{ section.settings.duration }}ms">
 <div class="premium-slides" tabindex="0" role="region" aria-label="{{ section.settings.heading | default: shop.name | escape }}">
 {% for block in section.blocks %}<article class="premium-slide" {{ block.shopify_attributes }}>
  <div class="premium-campaign-media">{% if block.settings.video != blank %}{{ block.settings.video | video_tag: image_size: '1800x', controls: true, autoplay: false, loop: false, muted: true, playsinline: true, preload: 'none' }}{% elsif block.settings.image != blank %}<picture>{% if block.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url: width: 900 }}">{% endif %}{% assign campaign_loading = 'lazy' %}{% if section.index == 1 and forloop.first %}{% assign campaign_loading = 'eager' %}{% endif %}{{ block.settings.image | image_url: width: 2200 | image_tag: widths: '600, 900, 1400, 1800, 2200', sizes: '100vw', loading: campaign_loading }}</picture>{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div>
  <div class="premium-campaign-copy">{% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ block.settings.heading | escape }}</h2>{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}{% if block.settings.link != blank %}<a data-control="primary" class="button" href="{{ block.settings.link }}">{{ block.settings.label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div>
 </article>{% endfor %}
 </div>
 {% if section.blocks.size > 1 %}<div class="premium-rail-controls" hidden><button data-control="icon" type="button" data-previous aria-label="{{ 'premium.previous' | t }}">←</button><button data-control="icon" type="button" data-play aria-label="{{ 'premium.pause' | t }}" data-pause-label="{{ 'premium.pause' | t }}" data-play-label="{{ 'premium.play' | t }}">Ⅱ</button><button data-control="icon" type="button" data-next aria-label="{{ 'premium.next' | t }}">→</button></div>{% endif %}
</premium-campaign><script src="{{ 'premium-rails.js' | asset_url }}" type="module"></script>

{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
{% schema %}
{
