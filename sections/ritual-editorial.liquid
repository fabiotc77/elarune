{{ 'ritual-editorial.css' | asset_url | stylesheet_tag }}
<section class="ritual-editorial" aria-labelledby="RitualEditorial-{{ section.id }}">
  <header class="ritual-editorial__heading">
    <h2 id="RitualEditorial-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.second_line != blank %}<em>{{ section.settings.second_line | escape }}</em>{% endif %}</h2>
  </header>
  {% if section.settings.image != blank %}
    <div class="ritual-editorial__media" style="--editorial-position: {{ section.settings.mobile_position }}%">
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: section.settings.alt }}
    </div>
  {% elsif request.design_mode %}
    <div class="ritual-editorial__media ritual-editorial__media--placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}
</section>
{% schema %}
{"name":"t:ritual_editorial.name","tag":"section","disabled_on":{"groups":["header","footer"]},"settings":[{"type":"text","id":"heading","label":"t:ritual_editorial.heading","default":"Your skin doesn’t need more."},{"type":"text","id":"second_line","label":"t:ritual_editorial.second_line","default":"It needs the right rhythm."},{"type":"image_picker","id":"image","label":"t:ritual_editorial.image"},{"type":"text","id":"alt","label":"t:ritual_editorial.alt"},{"type":"range","id":"mobile_position","label":"t:ritual_editorial.mobile_position","min":0,"max":100,"step":5,"unit":"%","default":70}],"presets":[{"name":"t:ritual_editorial.name"}]}
{% endschema %}
