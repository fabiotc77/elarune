{%- capture premium_section_body -%}
{% liquid
  assign has_before = false
  if section.settings.before_image != blank
    assign has_before = true
  endif
  assign has_after = false
  if section.settings.after_image != blank
    assign has_after = true
  endif

  assign show_section = false
  if has_before and has_after
    assign show_section = true
  endif
%}
{% if show_section %}
  {{ 'beauty.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'beauty.js' | asset_url }}" type="module"></script>
  <section class="page-width section-space" aria-labelledby="ComparisonHeading-{{ section.id }}">
    <div class="section-heading"><h2 id="ComparisonHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% if section.settings.context != blank %}<p class="muted">{{ section.settings.context | escape }}</p>{% endif %}</div>
    <before-after class="before-after" style="--position:50%">
      <div class="comparison-images">
        <figure class="comparison-before">{{ section.settings.before_image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 80vw, 100vw', loading: 'lazy' }}<figcaption>{{ 'beauty.before' | t }}</figcaption></figure>
        <figure class="comparison-after">{{ section.settings.after_image | image_url: width: 1400 | image_tag: widths: '400, 700, 1000, 1400', sizes: '(min-width: 750px) 80vw, 100vw', loading: 'lazy' }}<figcaption>{{ 'beauty.after' | t }}</figcaption></figure>
        <span class="comparison-divider" aria-hidden="true" hidden>↔</span>
      </div>
      <div class="comparison-control" hidden><label for="Comparison-{{ section.id }}">{{ 'beauty.compare' | t }}</label><input data-control="range" id="Comparison-{{ section.id }}" type="range" min="0" max="100" step="1" value="50"></div>
    </before-after>
    {% if section.settings.disclaimer != blank %}<p class="beauty-disclaimer">{{ section.settings.disclaimer | escape }}</p>{% endif %}
  </section>
{% elsif request.design_mode %}<aside class="page-width editor-note">{{ 'beauty.editor_note' | t }}</aside>{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
