{{ 'customer.css' | asset_url | stylesheet_tag }}
<section class="customer page-width section-space" aria-labelledby="CustomerRegister-{{ section.id }}-title">
  <div class="customer__panel">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow customer__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="customer__title" id="CustomerRegister-{{ section.id }}-title">{{ 'customer.register.title' | t }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="customer__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    <div class="customer__pane">
      {%- form 'create_customer', class: 'customer__form' -%}
        {%- if form.errors -%}
          <div class="customer__notice customer__notice--error" role="alert" tabindex="-1" autofocus>
            <ul class="customer__error-list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="customer__field-row">
          <div class="customer__field">
            <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
            <input data-control="field" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
          </div>
          <div class="customer__field">
            <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
            <input data-control="field" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
          </div>
        </div>
        <div class="customer__field">
          <label for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
          <input data-control="field" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" autocorrect="off" autocapitalize="off" spellcheck="false" required>
        </div>
        <div class="customer__field">
          <label for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
          <input data-control="field" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
        </div>
        <button data-control="primary" class="button customer__submit" type="submit">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}
      <p class="customer__alt">
        {{ 'customer.register.has_account' | t }}
        <a data-control="text" class="text-link" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
      </p>
    </div>
  </div>
</section>
{% schema %}
{"name":"t:customer.register.name","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"t:editor.text.eyebrow_d821dd","default":"Account"},{"type":"textarea","id":"intro","label":"t:editor.text.description_526e00"}]}
{% endschema %}
