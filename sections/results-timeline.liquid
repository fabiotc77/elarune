{%- capture premium_section_body -%}
{% liquid
  assign milestone_count = 0
  for block in section.blocks
    if block.settings.period != blank and block.settings.title != blank and block.settings.text != blank
      assign milestone_count = milestone_count | plus: 1
    endif
  endfor
  assign timeline_title = section.settings.heading
  if timeline_title == blank
    assign timeline_title = 'results_timeline.title' | t
  endif
%}
{% if milestone_count > 0 or request.design_mode %}
  {{ 'results-timeline.css' | asset_url | stylesheet_tag }}
  <section class="results-timeline page-width section-space" aria-labelledby="TimelineTitle-{{ section.id }}">
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="TimelineTitle-{{ section.id }}">{{ timeline_title | escape }}</h2>
      </div>
      {% if section.settings.introduction != blank %}<p class="muted">{{ section.settings.introduction | escape }}</p>{% endif %}
    </div>
    {% if section.blocks.size > 0 %}
      <ol class="results-timeline__list" role="list">
        {% for block in section.blocks %}
          {% if block.settings.period != blank and block.settings.title != blank and block.settings.text != blank %}
            <li class="results-timeline__milestone" {{ block.shopify_attributes }}>
              <p class="results-timeline__period eyebrow">{{ block.settings.period | escape }}</p>
              <h3 id="TimelineMilestone-{{ section.id }}-{{ block.id }}">{{ block.settings.title | escape }}</h3>
              {% if block.settings.image != blank %}
                <div class="results-timeline__media">
                  {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '320, 480, 750, 1000', sizes: '(min-width: 1440px) 420px, (min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw', loading: 'lazy' }}
                </div>
              {% endif %}
              <p class="results-timeline__text">{{ block.settings.text | escape | newline_to_br }}</p>
              {% if block.settings.source_note != blank %}<p class="results-timeline__source muted">{{ block.settings.source_note | escape | newline_to_br }}</p>{% endif %}
              {% if block.settings.source_url != blank %}
                <a data-control="text" class="results-timeline__link text-link" href="{{ block.settings.source_url | escape }}">{{ 'results_timeline.evidence' | t }}<span class="visually-hidden">: {{ block.settings.period | escape }} — {{ block.settings.title | escape }}</span></a>
              {% endif %}
            </li>
          {% elsif request.design_mode %}
            <li class="results-timeline__placeholder editor-note" {{ block.shopify_attributes }}>{{ 'results_timeline.empty' | t }}</li>
          {% endif %}
        {% endfor %}
      </ol>
    {% elsif request.design_mode %}
      <p class="editor-note">{{ 'results_timeline.empty' | t }}</p>
    {% endif %}
    {% if section.settings.context != blank %}<p class="results-timeline__context muted">{{ section.settings.context | escape | newline_to_br }}</p>{% endif %}
  </section>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
