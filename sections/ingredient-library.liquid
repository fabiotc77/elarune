{%- capture premium_section_body -%}
{% liquid
  assign ingredient_count = 0
  for block in section.blocks
    if block.settings.name != blank or block.settings.image != blank or block.settings.description != blank or block.settings.inci != blank
      assign ingredient_count = ingredient_count | plus: 1
    elsif block.settings.source != blank and block.settings.source_label != blank
      assign ingredient_count = ingredient_count | plus: 1
    endif
  endfor
  assign card_number = 0
  assign library_layout = section.settings.layout | default: 'editorial'
%}
{% if ingredient_count > 0 or request.design_mode %}
  {{ 'ingredient-library.css' | asset_url | stylesheet_tag }}
  <section class="ingredient-library page-width section-space"{% if section.settings.heading != blank %} aria-labelledby="Ingredients-{{ section.id }}"{% endif %}>
    <div class="section-heading ingredient-library__heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 id="Ingredients-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      </div>
      {% if section.settings.description != blank %}<div class="rte ingredient-library__introduction">{{ section.settings.description }}</div>{% endif %}
    </div>
    <div class="ingredient-library__cards">
      {% for block in section.blocks %}
        {% liquid
          assign has_content = false
          if block.settings.name != blank or block.settings.image != blank or block.settings.description != blank or block.settings.inci != blank
            assign has_content = true
          elsif block.settings.source != blank and block.settings.source_label != blank
            assign has_content = true
          endif
        %}
        {% if has_content %}
          {% liquid
            assign card_number = card_number | plus: 1
            assign featured = false
            if library_layout == 'editorial' and ingredient_count > 2 and card_number == 1 and block.settings.image != blank
              assign featured = true
            endif
          %}
          <article class="ingredient-library__card{% if featured %} ingredient-library__card--featured{% endif %}{% if block.settings.image == blank %} ingredient-library__card--text-only{% endif %}"{% if block.settings.name != blank %} aria-labelledby="Ingredient-{{ section.id }}-{{ block.id }}"{% endif %} {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="ingredient-library__image">
                {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy' }}
              </div>
            {% endif %}
            <div class="ingredient-library__copy">
              <div class="ingredient-library__meta"><span class="ingredient-library__number" aria-hidden="true">{% if card_number < 10 %}0{% endif %}{{ card_number }}</span>{% if block.settings.inci != blank %}<p class="eyebrow">{{ block.settings.inci | escape }}</p>{% endif %}</div>
              {% if block.settings.name != blank %}<h3 id="Ingredient-{{ section.id }}-{{ block.id }}">{{ block.settings.name | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
              {% if block.settings.source != blank and block.settings.source_label != blank %}<a data-control="text" class="text-link ingredient-library__source" href="{{ block.settings.source | escape }}">{{ block.settings.source_label | escape }}<span aria-hidden="true">↗</span></a>{% endif %}
            </div>
          </article>
        {% elsif request.design_mode %}
          <div class="ingredient-library__empty" {{ block.shopify_attributes }}></div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
