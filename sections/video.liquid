      "id": "experience_top",
      "label": "t:premium.top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "experience_bottom",
      "label": "t:premium.bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:video_section.name"
    }
  ]
}
{% endschema %}
