{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
{%- liquid
  assign source = section.settings.source
  assign layout = section.settings.layout
  assign has_video = false
  assign video_host = 'shopify'
  assign external_id = ''

  if source == 'external'
    if section.settings.video_url != blank
      assign video_host = section.settings.video_url.type | append: ''
      assign external_id = section.settings.video_url.id | append: ''
      if external_id != blank
        if video_host == 'youtube' or video_host == 'vimeo'
          assign has_video = true
        endif
      endif
    endif
  elsif section.settings.video != blank
    assign has_video = true
  endif

  comment
    Muted looping playback is offered for Shopify-hosted files only; YouTube and Vimeo always stay behind the click-to-load facade.
  endcomment
  assign mode = 'click'
  if has_video and source == 'shopify' and section.settings.autoplay
    assign mode = 'background'
  endif

  assign heading_id = 'VideoHeading-' | append: section.id
  assign video_title = section.settings.video_title | strip
  if video_title == blank
    assign video_title = section.settings.heading | strip
  endif
  if video_title == blank and source == 'shopify' and section.settings.video != blank
    assign video_title = section.settings.video.alt | strip
  endif
  if video_title == blank
    assign video_title = 'video_section.fallback_title' | t
  endif

  assign has_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign has_button = true
  endif
  assign has_copy = has_button
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign has_copy = true
  endif

  assign media_sizes = '100vw'
  if layout == 'contained'
    assign media_sizes = '(min-width: 1440px) 1312px, 100vw'
  endif
-%}
{%- if has_video or request.design_mode -%}
  {{ 'section-video.css' | asset_url | stylesheet_tag }}
  {%- if has_video -%}<script src="{{ 'section-video.js' | asset_url }}" type="module" defer></script>{%- endif -%}

  {%- capture video_copy -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow video-feature__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="video-feature__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte video-feature__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if has_button -%}<a class="video-feature__button" data-control="primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
  {%- endcapture -%}

  {%- capture play_control -%}
    {%- if has_video and mode == 'click' -%}
      {%- assign play_label = 'video_section.load_video' | t: title: video_title -%}
      {%- capture play_icon -%}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.5 5.8v12.4L18.4 12z" fill="currentColor" stroke="none"/></svg>{%- endcapture -%}
      {%- if source == 'external' -%}
        <a class="video-feature__play" data-control="primary" href="{{ section.settings.video_url }}" data-video-play aria-label="{{ play_label | escape }}">{{ play_icon }}<span>{{ 'video_section.play' | t }}</span></a>
      {%- else -%}
        <button type="button" class="video-feature__play" data-control="primary" data-video-play aria-label="{{ play_label | escape }}" hidden>{{ play_icon }}<span>{{ 'video_section.play' | t }}</span></button>
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}

  <section class="video-feature video-feature--{{ layout }} section-space"{% if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{% else %} aria-label="{{ video_title | escape }}"{% endif %}>
    {%- if layout != 'background' and has_copy -%}
      <div class="page-width video-feature__head">{{ video_copy }}</div>
    {%- endif -%}

    <div class="video-feature__frame{% if layout == 'contained' %} page-width{% endif %}">
      <video-feature
        class="video-feature__media"
        data-mode="{{ mode }}"
        data-host="{{ video_host }}"
        {% if external_id != blank %}data-video-id="{{ external_id | escape }}"{% endif %}
        data-title="{{ video_title | escape }}"
        data-state="idle"
        {% if layout == 'background' and has_copy %}data-overlay{% endif %}
        style="--video-ratio:{{ section.settings.ratio_desktop }};--video-ratio-mobile:{{ section.settings.ratio_mobile }};--video-scrim:{{ section.settings.overlay_opacity | divided_by: 100.0 }}"
      >
        <div class="video-feature__stage">
          <div class="video-feature__poster">
            {%- if section.settings.poster != blank -%}
              {%- capture poster_style -%}object-position:{{ section.settings.poster.presentation.focal_point | default: '50% 50%' }}{%- endcapture -%}
              {{ section.settings.poster | image_url: width: 2400 | image_tag: widths: '480, 750, 1080, 1500, 1920, 2400', sizes: media_sizes, loading: 'lazy', alt: '', class: 'video-feature__image', style: poster_style }}
            {%- elsif source == 'shopify' and section.settings.video != blank and section.settings.video.preview_image != blank -%}
              {%- capture poster_style -%}object-position:{{ section.settings.video.preview_image.presentation.focal_point | default: '50% 50%' }}{%- endcapture -%}
              {{ section.settings.video.preview_image | image_url: width: 2400 | image_tag: widths: '480, 750, 1080, 1500, 1920, 2400', sizes: media_sizes, loading: 'lazy', alt: '', class: 'video-feature__image', style: poster_style }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'video-feature__placeholder' }}
            {%- endif -%}
          </div>

          {%- if mode == 'background' -%}
            {{ section.settings.video | video_tag: image_size: '1920x', autoplay: false, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', class: 'video-feature__video', aria-hidden: 'true', tabindex: '-1' }}
          {%- elsif has_video and source == 'shopify' -%}
            <template data-video-template>{{ section.settings.video | video_tag: image_size: '1920x', autoplay: true, loop: false, muted: false, playsinline: true, controls: true, preload: 'metadata', class: 'video-feature__video' }}</template>
            <noscript><div class="video-feature__noscript">{{ section.settings.video | video_tag: image_size: '1920x', autoplay: false, playsinline: true, controls: true, preload: 'none', class: 'video-feature__video' }}</div></noscript>
          {%- endif -%}
          <div class="video-feature__player" data-video-player></div>
        </div>

        {%- if layout == 'background' and has_copy -%}
          <div class="video-feature__overlay">
            <div class="video-feature__overlay-inner">{{ video_copy }}{% if play_control != blank %}<div class="video-feature__overlay-play">{{ play_control }}</div>{% endif %}</div>
          </div>
        {%- elsif play_control != blank -%}
          <div class="video-feature__center">{{ play_control }}</div>
        {%- endif -%}

        {%- if mode == 'background' -%}
          <button type="button" class="video-feature__toggle" data-control="icon" data-video-toggle aria-label="{{ 'video_section.pause' | t }}" data-label-play="{{ 'video_section.play' | t }}" data-label-pause="{{ 'video_section.pause' | t }}" hidden>
            <svg class="video-feature__icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5h2.6v13H8zM13.4 5.5H16v13h-2.6z" fill="currentColor" stroke="none"/></svg>
            <svg class="video-feature__icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.5 5.8v12.4L18.4 12z" fill="currentColor" stroke="none"/></svg>
          </button>
        {%- endif -%}
      </video-feature>
    </div>

    {%- if request.design_mode and has_video == false -%}
      <div class="page-width"><p class="editor-note">{{ 'video_section.editor_empty' | t }}</p></div>
    {%- endif -%}
  </section>
{%- endif -%}
{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
{% schema %}
{
  "name": "t:video_section.name",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:video_section.name"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:video_section.source",
      "options": [
        {
          "value": "shopify",
          "label": "t:editor.text.shopify_hosted_video_000e5d"
        },
        {
          "value": "external",
          "label": "t:video_section.source_external"
        }
      ],
      "default": "shopify"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:editor.text.shopify_hosted_video_000e5d"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:video_section.video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "t:video_section.video_url_info"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "t:editor.text.video_title_ff9a99",
      "info": "t:video_section.video_title_info"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "t:video_section.poster",
      "info": "t:video_section.poster_info"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:video_section.autoplay",
      "info": "t:video_section.autoplay_info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:editor.text.layout_a51190"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:editor.text.layout_a51190",
      "options": [
        {
          "value": "contained",
          "label": "t:video_section.layout_contained"
        },
        {
          "value": "full",
          "label": "t:editor.text.full_width_d34008"
        },
        {
          "value": "background",
          "label": "t:video_section.layout_background"
        }
      ],
      "default": "contained"
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "t:video_section.ratio_desktop",
      "options": [
        {
          "value": "16/9",
          "label": "t:video_section.ratio_16_9"
        },
        {
          "value": "4/3",
          "label": "t:video_section.ratio_4_3"
        },
        {
          "value": "21/9",
          "label": "t:video_section.ratio_21_9"
        },
        {
          "value": "1/1",
          "label": "t:video_section.ratio_1_1"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "t:video_section.ratio_mobile",
      "options": [
        {
          "value": "9/16",
          "label": "t:video_section.ratio_9_16"
        },
        {
          "value": "4/5",
          "label": "t:video_section.ratio_4_5"
        },
        {
          "value": "1/1",
          "label": "t:video_section.ratio_1_1"
        },
        {
          "value": "16/9",
          "label": "t:video_section.ratio_16_9"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:video_section.overlay_opacity",
      "info": "t:video_section.overlay_opacity_info",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:editor.text.content_47bd29"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:editor.text.eyebrow_d821dd"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:editor.text.heading_b34f17",
      "default": "A closer look"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:editor.text.text_71988c"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:editor.text.button_label_57a953"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:editor.text.button_link_168eeb"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
