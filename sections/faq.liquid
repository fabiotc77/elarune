{% render 'section-scheme', section: section %}
{%- capture premium_section_body -%}
<section class="page-width section-space content-page faq-section" aria-labelledby="Faq-{{ section.id }}">
  <div class="faq-section-header">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow faq-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 id="Faq-{{ section.id }}" class="faq-heading">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.intro != blank %}<p class="faq-intro">{{ section.settings.intro | escape }}</p>{% endif %}
  </div>
  <div class="faq-accordion-group">
    {% for block in section.blocks %}
      {% if block.settings.answer != blank %}
        <details class="product-accordion faq-accordion-item" {{ block.shopify_attributes }}>
          <summary data-control="disclosure">
            <span class="faq-number">0{{ forloop.index }}</span>
            <span class="faq-question-text">{{ block.settings.question | escape }}</span>
          </summary>
          <div class="rte faq-answer-text">{{ block.settings.answer }}</div>
        </details>
      {% elsif request.design_mode %}
        <p class="editor-note" {{ block.shopify_attributes }}>{{ 'faq.editor_note' | t }}</p>
      {% endif %}
    {% endfor %}
  </div>
</section>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
