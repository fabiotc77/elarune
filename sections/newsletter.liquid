{%- capture premium_section_body -%}
{% liquid
  assign newsletter_id = 'Newsletter-' | append: section.id
  assign email_id = newsletter_id | append: '-email'
  assign newsletter_heading = section.settings.heading
  if newsletter_heading == blank
    assign newsletter_heading = 'newsletter.heading' | t
  endif
%}
{{ 'newsletter.css' | asset_url | stylesheet_tag }}
<section class="newsletter{% if section.settings.image == blank and section.settings.show_sample_image != true %} newsletter--text-only{% endif %}" aria-labelledby="{{ newsletter_id }}-title" style="--newsletter-background:{{ section.settings.background_color }};--newsletter-foreground:{{ section.settings.text_color }};">
  {% if section.settings.image != blank %}
    <div class="newsletter__media">
      {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy', class: 'newsletter__image' }}
    </div>
  {% elsif section.settings.show_sample_image %}
    <div class="newsletter__media">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'newsletter__image placeholder-svg' }}
    </div>
  {% endif %}
  <div class="newsletter__content">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow newsletter__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2 id="{{ newsletter_id }}-title">{{ newsletter_heading | escape }}</h2>
    {% if section.settings.text != blank %}<div class="rte newsletter__intro">{{ section.settings.text }}</div>{% endif %}
    {% form 'customer', id: newsletter_id, class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="newsletter__notice" role="status" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</p>
      {% else %}
        {% if form.errors %}
          <div class="newsletter__notice" role="alert" tabindex="-1" autofocus aria-labelledby="{{ newsletter_id }}-error-title">
            <h3 id="{{ newsletter_id }}-error-title">{{ 'newsletter.error_heading' | t }}</h3>
            <ul>
              {% for field in form.errors %}
                <li>{% if field == 'email' %}<a href="#{{ email_id }}">{% endif %}{{ form.errors.translated_fields[field] | capitalize | escape }} {{ form.errors.messages[field] | escape }}{% if field == 'email' %}</a>{% endif %}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        <label class="newsletter__label" for="{{ email_id }}">{{ 'newsletter.email' | t }}</label>
        <div class="newsletter__fields">
          <input data-control="field" id="{{ email_id }}" type="email" name="contact[email]" autocomplete="email" inputmode="email" autocorrect="off" autocapitalize="off" required value="{{ form.email | escape }}" aria-describedby="{{ newsletter_id }}-consent{% if form.errors contains 'email' %} {{ newsletter_id }}-email-error{% endif %}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          <button data-control="primary" type="submit" class="newsletter__submit"><span>{{ 'newsletter.subscribe' | t }}</span><span aria-hidden="true">↗</span></button>
        </div>
        {% if form.errors contains 'email' %}<p id="{{ newsletter_id }}-email-error" class="newsletter__field-error">{{ form.errors.translated_fields.email | capitalize | escape }} {{ form.errors.messages.email | escape }}</p>{% endif %}
        <p class="newsletter__consent" id="{{ newsletter_id }}-consent">{{ 'newsletter.consent' | t: shop: shop.name | escape }}</p>
      {% endif %}
    {% endform %}
    {% if section.settings.details != blank %}<div class="rte newsletter__details">{{ section.settings.details }}</div>{% endif %}
  </div>
</section>


{%- endcapture -%}
{%- assign premium_section_content = premium_section_body | strip -%}
{%- if premium_section_content != blank -%}
<premium-section data-motion="{{ section.settings.experience_motion | default: 'inherit' }}" data-intensity="{{ section.settings.experience_intensity | default: 'restrained' }}" data-parallax="{{ section.settings.experience_parallax }}" data-width="{{ section.settings.experience_width | default: 'inherit' }}" data-spacing="{{ section.settings.experience_spacing }}" style="--experience-space-top:{{ section.settings.experience_top | default: 64 }}px;--experience-space-bottom:{{ section.settings.experience_bottom | default: 64 }}px">
{{ premium_section_body }}
</premium-section>
{%- endif -%}
