<!doctype html>
{%- liquid
  assign direction = 'ltr'
  assign language_code = request.locale.iso_code | split: '-' | first
  if language_code == 'ar' or language_code == 'he' or language_code == 'fa' or language_code == 'ur'
    assign direction = 'rtl'
  endif
-%}
<html data-control-language="elarune" lang="{{ request.locale.iso_code | escape }}" dir="{{ direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {% if settings.favicon != blank %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {% else %}
      <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
      <link rel="icon" href="{{ 'elarune-favicon-32.png' | asset_url }}" type="image/png" sizes="32x32">
      <link rel="apple-touch-icon" href="{{ 'elarune-favicon-180.png' | asset_url }}">
    {% endif %}
    <title>{{ page_title }}</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% render 'brand-settings' %}
    {{ 'control-language.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  </body>
</html>
