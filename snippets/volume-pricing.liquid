{%- comment -%}
  Quantity tiers
  Each card sets the product form quantity. Tier totals shown here use the discount percentages configured
  in this block. Shopify automatic discounts remain responsible for applying the actual discount at checkout.
  Tiers are only offered when they satisfy the variant's quantity rules, so a card never selects a quantity checkout rejects.
{%- endcomment -%}

{% liquid
  assign tier1_qty = 1
  assign tier2_qty = block.settings.tier2_qty | default: 2
  assign tier3_qty = block.settings.tier3_qty | default: 3

  assign show_discount_labels = false
  if block.settings.show_discount_labels == true
    assign show_discount_labels = true
  endif

  assign tier1_label = block.settings.tier1_label
  if tier1_label == blank
    assign tier1_label = 'volume_pricing.single_pack' | t
  endif

  assign tier2_label = block.settings.tier2_label
  if tier2_label == blank
    assign tier2_label = 'neutral.volume_pricing.pack_of' | t: quantity: tier2_qty
  endif

  assign tier3_label = block.settings.tier3_label
  if tier3_label == blank
    assign tier3_label = 'neutral.volume_pricing.pack_of' | t: quantity: tier3_qty
  endif

  assign tier2_badge = block.settings.tier2_badge
  assign tier3_badge = block.settings.tier3_badge

  assign base_price = variant.price | default: 0
  assign tier2_total_price = base_price | times: tier2_qty
  assign tier3_total_price = base_price | times: tier3_qty

  assign tier2_discount = block.settings.tier2_discount | default: 0 | plus: 0
  assign tier3_discount = block.settings.tier3_discount | default: 0 | plus: 0

  if tier2_discount < 0
    assign tier2_discount = 0
  elsif tier2_discount > 100
    assign tier2_discount = 100
  endif
  if tier3_discount < 0
    assign tier3_discount = 0
  elsif tier3_discount > 100
    assign tier3_discount = 100
  endif

  assign tier2_factor = 100 | minus: tier2_discount
  assign tier3_factor = 100 | minus: tier3_discount
  assign tier2_discounted_price = tier2_total_price | times: tier2_factor | divided_by: 100.0 | round
  assign tier3_discounted_price = tier3_total_price | times: tier3_factor | divided_by: 100.0 | round

  comment
    Calculate per-item prices from the same configurable discount percentages.
    Shopify prices are stored in cents, so round each per-item amount to the nearest cent for display.
  endcomment
  assign tier2_discounted_unit_price = base_price | times: tier2_factor | divided_by: 100.0 | round
  assign tier3_discounted_unit_price = base_price | times: tier3_factor | divided_by: 100.0 | round

  assign rule_min = variant.quantity_rule.min | default: 1
  assign rule_increment = variant.quantity_rule.increment | default: 1
  assign rule_max = variant.quantity_rule.max
  assign tiers_allowed = true
  if rule_min > 1 or rule_increment > 1
    assign tiers_allowed = false
  endif
  assign show_tier2 = true
  assign show_tier3 = true
  if rule_max != blank
    if tier2_qty > rule_max
      assign show_tier2 = false
    endif
    if tier3_qty > rule_max
      assign show_tier3 = false
    endif
  endif
%}

{% if variant.available and tiers_allowed %}
<div class="product-volume-pricing" data-volume-pricing>
  {% if block.settings.heading != blank %}
    <div class="volume-pricing__header">
      <span class="volume-pricing__title">{{ block.settings.heading | escape }}</span>
      {% if block.settings.subheading != blank %}
        <span class="volume-pricing__subheading">{{ block.settings.subheading | escape }}</span>
      {% endif %}
    </div>
  {% endif %}

  <div class="volume-pricing__grid" role="radiogroup" aria-label="{{ 'volume_pricing.select_tier' | t | escape }}">
    <label class="volume-tier-card is-selected" data-volume-tier="{{ tier1_qty }}">
      <input class="visually-hidden" type="radio" name="VolumeTier-{{ section_id }}" value="{{ tier1_qty }}" checked>
      <span class="volume-tier-card__radio" aria-hidden="true">
        <span class="volume-radio-disc"></span>
      </span>
      <span class="volume-tier-card__info">
        <span class="volume-tier-card__name">{{ tier1_label | escape }}</span>
        <span class="volume-tier-card__sub">{{ 'volume_pricing.standard_pack' | t }}</span>
      </span>
      <span class="volume-tier-card__pricing">
        <span class="volume-tier-card__price">{{ base_price | money }}</span>
        <span class="volume-tier-card__per-unit">{{ 'volume_pricing.each' | t }}</span>
      </span>
    </label>

    {% if show_tier2 %}
      <label class="volume-tier-card" data-volume-tier="{{ tier2_qty }}">
        <input class="visually-hidden" type="radio" name="VolumeTier-{{ section_id }}" value="{{ tier2_qty }}">
        {% if tier2_badge != blank %}
          <span class="volume-tier-badge volume-tier-badge--popular">{{ tier2_badge | escape }}</span>
        {% endif %}
        <span class="volume-tier-card__radio" aria-hidden="true">
          <span class="volume-radio-disc"></span>
        </span>
        <span class="volume-tier-card__info">
          <span class="volume-tier-card__name">{{ tier2_label | escape }}</span>
          {% if show_discount_labels and block.settings.tier2_discount != blank %}
            <span class="volume-tier-card__discount">{{ 'neutral.volume_pricing.discount_at_checkout' | t: percent: block.settings.tier2_discount }}</span>
          {% endif %}
        </span>
        <span class="volume-tier-card__pricing">
          {% if tier2_discount > 0 %}<span class="volume-tier-card__price">{{ tier2_discounted_price | money }}</span><span class="volume-tier-card__compare-price"><s>{{ tier2_total_price | money }}</s></span>{% else %}<span class="volume-tier-card__price">{{ tier2_total_price | money }}</span>{% endif %}
          <span class="volume-tier-card__per-unit">{% if tier2_discount > 0 %}{{ tier2_discounted_unit_price | money }}{% else %}{{ base_price | money }}{% endif %}/{{ 'volume_pricing.each' | t }}</span>
        </span>
      </label>
    {% endif %}

    {% if show_tier3 %}
      <label class="volume-tier-card" data-volume-tier="{{ tier3_qty }}">
        <input class="visually-hidden" type="radio" name="VolumeTier-{{ section_id }}" value="{{ tier3_qty }}">
        {% if tier3_badge != blank %}
          <span class="volume-tier-badge volume-tier-badge--best">{{ tier3_badge | escape }}</span>
        {% endif %}
        <span class="volume-tier-card__radio" aria-hidden="true">
          <span class="volume-radio-disc"></span>
        </span>
        <span class="volume-tier-card__info">
          <span class="volume-tier-card__name">{{ tier3_label | escape }}</span>
          {% if show_discount_labels and block.settings.tier3_discount != blank %}
            <span class="volume-tier-card__discount">{{ 'neutral.volume_pricing.discount_at_checkout' | t: percent: block.settings.tier3_discount }}</span>
          {% endif %}
        </span>
        <span class="volume-tier-card__pricing">
          {% if tier3_discount > 0 %}<span class="volume-tier-card__price">{{ tier3_discounted_price | money }}</span><span class="volume-tier-card__compare-price"><s>{{ tier3_total_price | money }}</s></span>{% else %}<span class="volume-tier-card__price">{{ tier3_total_price | money }}</span>{% endif %}
          <span class="volume-tier-card__per-unit">{% if tier3_discount > 0 %}{{ tier3_discounted_unit_price | money }}{% else %}{{ base_price | money }}{% endif %}/{{ 'volume_pricing.each' | t }}</span>
        </span>
      </label>
    {% endif %}
  </div>
</div>
{% endif %}
