{% comment %}Version shared module dependencies with Shopify's own asset URLs. No assets are fetched by this map alone.{% endcomment %}
{%- assign premium_modules = 'premium-motion.js,premium-purchase-intent.js,premium-cart-morph.js,premium-filters.js,premium-gallery.js,quantity-stepper.js,product-image-zoom.js,product-model.js,product-external-video.js' | split: ',' -%}
<script type="importmap">{"imports":{ {%- for module_name in premium_modules -%}{%- assign module_url = module_name | asset_url -%}{{ module_url | split: '?' | first | json }}:{{ module_url | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }}</script>
