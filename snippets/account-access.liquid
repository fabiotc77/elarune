{% if shop.customer_accounts_enabled %}
  {% assign account_menu = section.settings.customer_account_menu.handle | default: 'customer-account-main-menu' %}
  <div class="account-access">
    <shopify-account menu="{{ account_menu | escape }}">
      <span slot="signed-out-avatar" class="account-access__icon" aria-label="{{ 'account_access.title' | t | escape }}">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"/></svg>
      </span>
    </shopify-account>
    <a data-control="navigation" class="account-access__fallback" href="{{ routes.account_url }}" aria-label="{{ 'account_access.title' | t | escape }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21v-2a7.5 7.5 0 0 1 15 0v2"/></svg>
    </a>
  </div>
{% endif %}
