{%- liquid
  assign share_title = page_title | default: shop.name
  assign share_description = page_description | default: shop.description
  assign share_type = 'website'
  if request.page_type == 'product'
    assign share_type = 'product'
  elsif request.page_type == 'article'
    assign share_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url | escape }}">
<meta property="og:title" content="{{ share_title | escape }}">
<meta property="og:type" content="{{ share_type }}">
<meta name="twitter:card" content="{% if page_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ share_title | escape }}">
{% if share_description != blank %}
  <meta property="og:description" content="{{ share_description | escape }}">
  <meta name="twitter:description" content="{{ share_description | escape }}">
{% endif %}
{% if page_image != blank %}
  {% assign share_image = page_image | image_url: width: 1200 %}
  {% assign image_prefix = share_image | slice: 0, 2 %}
  {% if image_prefix == '//' %}{% assign share_image = share_image | prepend: 'https:' %}{% endif %}
  <meta property="og:image" content="{{ share_image | escape }}">
  <meta name="twitter:image" content="{{ share_image | escape }}">
  {% if page_image.alt != blank %}<meta property="og:image:alt" content="{{ page_image.alt | escape }}"><meta name="twitter:image:alt" content="{{ page_image.alt | escape }}">{% endif %}
{% endif %}
